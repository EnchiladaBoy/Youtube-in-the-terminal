def version_text():
    """Return the public version plus trusted installer provenance.

    Install launchers may identify either an immutable ``vX.Y.Z`` source ref
    or the rolling ``edge`` channel. Any other environment value is ignored so
    control characters and unbounded text can never reach the terminal.
    """
    install_ref = os.environ.get(INSTALL_REF_ENV, "")
    valid_ref = (
        len(install_ref) <= _MAX_INSTALL_REF_LENGTH
        and (
            install_ref == "edge"
            or _VERSION_REF_RE.fullmatch(install_ref) is not None
        )
    )
    if not valid_ref:
        install_ref = "source"
    return f"yt-ascii {APP_VERSION} ({install_ref})"


def _effective_render_mode(requested, color):
    """Resolve the backend actually used for the selected color path.

    ``cells`` has no visible payload without background color and half-block
    needs both foreground/background colors to represent two pixels. Their
    documented ``--no-color`` behavior is therefore the portable ``chars``
    backend, never an empty frame.
    """
    if requested not in RENDER_MODES:
        choices = ", ".join(RENDER_MODES)
        raise ValueError(f"unknown rendering backend {requested!r}: {choices}")
    if not color and requested in ("cells", "half-block"):
        return "chars"
    return requested


def _requested_render_mode(args):
    """Read canonical settings with a compatibility path for API callers."""
    requested = getattr(args, "render", None)
    if requested is None:
        requested = "half-block" if getattr(args, "pixels", False) else "chars"
    return requested


