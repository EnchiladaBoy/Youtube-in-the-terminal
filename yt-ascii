# Terminal character cells are ~2x taller than wide; correct aspect ratio.
CHAR_ASPECT = 2.0

# Upper bound for --fps. Picked so that:
#   - YouTube: ≥99% of content tops out at 60 fps; higher values just duplicate
#     frames out of ffmpeg's fps filter, no visible benefit.
#   - Terminal: even GPU-accelerated terminals (alacritty/kitty/foot) start
#     dropping frames above this for full-window truecolor output.
MAX_FPS = 60

# Consecutive failed reconnects (at the same position) before we treat the
# stream as genuinely dead and stop.
MAX_STREAM_RETRIES = 3

# --scatter: default seconds for the random pop-in reveal to fill the screen.
# Cells appear one-by-one in a shuffled order from random spots until the
# picture is complete, so this wants to be short and
# snappy ("rapidly", per the effect). The video plays live behind it the whole
# time. Override with --scatter-secs.
SCATTER_SECS = 4.0

# --rain: default seconds for the Matrix-style rain reveal to fill the screen.
# The staggered columns finish over the back half of the window, so a slightly
# wider window reads better; this also sets how fast the glyphs fall (longer =
# slower). Override with --rain-secs.
RAIN_SECS = 7.5

# Glyph sets the --rain reveal can draw from, selected with --rain-chars. A fresh
# glyph is picked per cell each frame so the streaks shimmer like Matrix "digital
# rain". Every glyph MUST be a single terminal cell wide or the columns drift, so
# these are limited to single-width, left-to-right, non-combining scripts. That
# rules out double-width CJK (Han + full-width kana/Hangul) and RTL/combining
# scripts (Arabic, Hebrew, Thai, Devanagari…) — they'd ripple the columns. Korean
# and Japanese therefore use their HALF-width forms (jamo / katakana). Greek and
# Cyrillic are East-Asian-"ambiguous" width: one cell in a normal terminal, two
# only in a CJK locale set to ambiguous=wide. `polyglot` mixes every aligned
# script (letters), and `all` is the whole alphabet — every preset unioned,
# symbols included. The default ``ascii`` preset keeps the canonical chars
# backend Unicode-free. --rain-chars also takes a literal custom string, so the
# presets are just convenient names.
def _chars(*ranges):
    """Expand (lo, hi) inclusive Unicode codepoint ranges into a glyph string."""
    return "".join(chr(cp) for lo, hi in ranges for cp in range(lo, hi + 1))

_DIGITS   = "0123456789"
_LATIN    = _chars((0x41, 0x5A), (0x61, 0x7A))                # A-Z a-z
_KATAKANA = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ"   # half-width
_CYRILLIC = _chars((0x410, 0x44F))                           # А-я  (Russian)
_GREEK    = _chars((0x391, 0x3A1), (0x3A3, 0x3A9), (0x3B1, 0x3C9))  # Α-Ω α-ω (3A2 reserved)
_ARMENIAN = _chars((0x531, 0x556), (0x561, 0x586))           # Ա-Ֆ ա-ֆ
_GEORGIAN = _chars((0x10D0, 0x10F0))                         # ა-ჰ  (Mkhedruli)
_HANGUL   = _chars((0xFFA1, 0xFFBE), (0xFFC2, 0xFFC7),       # half-width jamo
                   (0xFFCA, 0xFFCF), (0xFFD2, 0xFFD7), (0xFFDA, 0xFFDC))

RAIN_CHARSETS = {
    "ascii":    _DIGITS + ":.=+*<>|/",
    "matrix":   _DIGITS + _KATAKANA + ":.=+*<>|/",
    "katakana": _KATAKANA,
    "english":  _LATIN + _DIGITS,
    "russian":  _CYRILLIC,
    "greek":    _GREEK,
    "armenian": _ARMENIAN,
    "georgian": _GEORGIAN,
    "korean":   _HANGUL,
    "polyglot": (_LATIN + _CYRILLIC + _GREEK + _ARMENIAN + _GEORGIAN
                 + _KATAKANA + _HANGUL + _DIGITS),
}
# `all` = the entire rain alphabet: every glyph from every preset above, deduped.
RAIN_CHARSETS["all"] = "".join(sorted(set("".join(RAIN_CHARSETS.values()))))
DEFAULT_RAIN_CHARS = "ascii"

# Let ffmpeg/ffplay ride out transient googlevideo failures — expired URL
# segments, 403/5xx throttling, TCP/TLS resets — instead of exiting, which
# otherwise shows up as the video never starting or cutting off partway
# through. These are input options, so they must precede -i / the input URL.
#   delay_max        - cap the wait between retries (exponential backoff)
#   delay_total_max  - after this many seconds of cumulative retrying, let
#                      ffmpeg give up so our own recover_stream() can show a
#                      "reconnecting…" hint and fetch a fresh URL, rather than
#                      freezing on a stale frame for minutes (ffmpeg's default
#                      total budget is 256s).
RECONNECT_FLAGS = [
    "-reconnect", "1",
    "-reconnect_streamed", "1",
    "-reconnect_on_network_error", "1",
    "-reconnect_on_http_error", "4xx,5xx",
    "-reconnect_delay_max", "5",
    "-reconnect_delay_total_max", "30",
]

# yt-dlp player clients to try (in order) when resolving YouTube streams.
# YouTube increasingly bot-checks the default web client from datacenter/VM IPs
# ("Sign in to confirm you're not a bot"); the android_vr client sidesteps that
# and rarely needs sign-in. Plain `android` is kept alongside it because some
# studio / DRM-gated uploads (e.g. Apple TV+ or Paramount clips) report "This
# video is not available" to android_vr/web/ios yet still serve a plain
# progressive stream to the `android` client. web/ios remain last-resort
# fallbacks. yt-dlp merges the formats found across all listed clients.
YOUTUBE_CLIENTS = ["android_vr", "android", "web", "ios"]


class ProbeError(Exception):
    """Raised when yt-dlp can't resolve a usable stream."""


def fps_type(value):
    """argparse type for --fps. Accepts an int in [1, MAX_FPS] or the
    literal 'max'."""
    if value.lower() == "max":
        return MAX_FPS
    try:
        n = int(value)
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError(
            f"--fps must be an integer 1..{MAX_FPS} or 'max' (got {value!r})"
        )
    if n < 1:
        raise argparse.ArgumentTypeError("--fps must be at least 1")
    if n > MAX_FPS:
        raise argparse.ArgumentTypeError(
            f"--fps {n} exceeds the maximum of {MAX_FPS}; "
            f"use '--fps max' to request the cap"
        )
    return n


def positive_int_type(value):
    """Validate dimensions and source-resolution caps before any network work."""
    try:
        number = int(value)
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError(
            f"must be a positive integer (got {value!r})"
        )
    if number < 1:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return number


