    # making the canonical backend selection unambiguous everywhere else.
    args.pixels = args.render == "half-block"
    moved_effect = LEGACY_STYLE_EFFECTS.get(args.style)
    moved_style = LEGACY_EFFECT_STYLES.get(args.effect)
    if moved_effect is not None:
        if args.effect != "none":
            p.error(
                f"legacy --style {args.style} now selects --effect "
                f"{moved_effect} and cannot be combined with --effect "
                f"{args.effect}"
            )
        args.style = "classic"
        args.effect = moved_effect
    elif moved_style is not None:
        if args.style != "classic":
            p.error(
                f"legacy --effect {args.effect} now selects --style "
                f"{moved_style} and cannot be combined with --style "
                f"{args.style}"
            )
        args.style = moved_style
        args.effect = "none"
    else:
        args.style = STYLE_ALIASES.get(args.style, args.style)
        args.effect = EFFECT_ALIASES.get(args.effect, args.effect)
    try:
        args.rain_chars = validate_rain_chars(args.rain_chars)
    except (TypeError, ValueError) as error:
        p.error(str(error))
    effective_render = _effective_render_mode(args.render, not args.no_color)
    if args.effect in TEXT_EFFECT_NAMES and effective_render != "chars":
        p.error(
            f"effect {args.effect!r} requires --render chars; graphical "
            f"effects are available with --render {args.render}"
        )
    try:
        args.effect_text = validate_effect_text(
            args.effect_text, args.effect_glyphs
        )
    except (TypeError, ValueError) as error:
        p.error(str(error))
    diagnostics_enabled = args.diagnostics_json is not None
    if not diagnostics_enabled and (
        args.diagnostics_warmup is not None
        or args.diagnostics_duration is not None
    ):
        p.error(
            "diagnostics tuning options require --diagnostics-json"
        )
    if diagnostics_enabled:
        if not args.diagnostics_json:
            p.error("--diagnostics-json FILE must be non-empty")
        if os.path.lexists(args.diagnostics_json):
            p.error(
                f"--diagnostics-json refuses to overwrite existing path: "
                f"{args.diagnostics_json}"
            )
        if not args.url:
            p.error("--diagnostics-json requires an explicit playback URL")
        if args.self_test or args.update or args.check_update:
            p.error("diagnostics are available only for normal URL playback")
        if args.diagnostics_warmup is None:
            args.diagnostics_warmup = 0.0
    return args


def prompt_for_url():
    """Interactive entry point: show a banner and let the user paste a YouTube
    link. Used when launched with no URL (e.g. by double-clicking the packaged
    executable). Returns the link; exits on q / Ctrl-D / Ctrl-C."""
    cyan, gray, bold, reset = "\x1b[36m", "\x1b[90m", "\x1b[1m", "\x1b[0m"
    sys.stdout.write(
        "\x1b[2J\x1b[H"
        f"{cyan}{bold}"
        "   +-----------------------------------------------+\n"
        "   | yt-ascii - terminal video, ASCII or graphical |\n"
        "   +-----------------------------------------------+"
        f"{reset}\n\n"
        f"{gray}   Paste a YouTube link and press Enter to play it.\n"
        "   While playing:  space=pause  <-/-> +-5s  up/down +-30s  "
        "0-9=jump  p=palette  s=style  e=effect  q=quit\n"
        "   Run with --help for renderer / color / audio / effect options."
        f"{reset}\n\n"
    )
    sys.stdout.flush()
    while True:
        try:
            line = input(f"   {cyan}>{reset} paste link (q to quit): ").strip()
        except (EOFError, KeyboardInterrupt):
            sys.stdout.write("\n")
            sys.exit(0)
        if line.lower() in ("q", "quit", "exit"):
            sys.exit(0)
        if line:
            return line


def _diagnostics_config(args):
    """Return an allowlisted, non-identifying snapshot of player settings."""
    import hashlib

    reveal = "rain" if args.rain else "scatter" if args.scatter else "none"
    requested_render = _requested_render_mode(args)
    effective_render = _effective_render_mode(
        requested_render, not args.no_color
    )
    try:
        stdout_tty = bool(getattr(sys.stdout, "isatty", lambda: False)())
    except (OSError, ValueError):
        stdout_tty = False
    default_output = (
        "sink" if not stdout_tty
        else "tmux" if os.environ.get("TMUX")
        else "attached"
    )
    effect_text = getattr(args, "effect_text", DEFAULT_EFFECT_TEXT)
    if not isinstance(effect_text, str):
        effect_text = DEFAULT_EFFECT_TEXT
    config = {
        "target_fps": args.fps,
        "width": args.width,
        "height": args.height,
        "max_res": args.max_res,
        "color": not args.no_color,
        "render_backend": requested_render,
        "effective_render_backend": effective_render,
        "audio": not args.no_audio,
        "eight_bit": args.eight_bit,
        "style": args.style,
        "effect": getattr(args, "effect", "none"),
        "glyph_mode": getattr(args, "effect_glyphs", "ascii"),
        "effect_speed": getattr(args, "effect_speed", 1.0),
        "effect_seed": getattr(args, "effect_seed", 0),
        "effect_text_sha256": hashlib.sha256(
            effect_text.encode("utf-8")
        ).hexdigest(),
        "output_environment": default_output,
        "palette": (
            "custom"
            if getattr(args, "chars", None) is not None
            else getattr(args, "palette", "dense")
        ),
        "reveal": reveal,
        "scatter": args.scatter,
        "rain": args.rain,
    }
    return config


def run(args, automatic_update_check=None):
    """Run playback, lazily enabling diagnostics only when explicitly asked."""
    report_path = getattr(args, "diagnostics_json", None)
    if report_path is None:
        # Keep the ordinary path free from diagnostics imports, clocks, temp
        # files, FFmpeg flags, and per-frame observer calls.
        _run_playback(args, automatic_update_check)
        return

    from yt_ascii_diagnostics import PlaybackDiagnostics

    stress_dimensions = (
        args.fps >= 60
        and (args.width or 0) >= 240
        and (args.height or 0) >= 68
    )
    profile = "stress" if stress_dimensions else "ordinary"
    diagnostics = PlaybackDiagnostics(
        report_path,
        getattr(args, "diagnostics_warmup", 0.0),
        getattr(args, "diagnostics_duration", None),
        config=_diagnostics_config(args),
        source={"kind": "remote"},
        profile=profile,
    )
    try:
        exit_reason = _run_playback(
            args, automatic_update_check, diagnostics=diagnostics
        )
    except BaseException as error:
        diagnostics.finalize(
            exit_reason="error", error_type=type(error).__name__
        )
        raise
    diagnostics.finalize(exit_reason=exit_reason or "normal")


def _run_playback(args, automatic_update_check=None, diagnostics=None):
    color = not args.no_color
    requested_render = _requested_render_mode(args)
    try:
        render_mode = _effective_render_mode(requested_render, color)
    except ValueError as error:
        fail(str(error))
    half_block = render_mode == "half-block"
    if getattr(args, "effect", "none") in TEXT_EFFECT_NAMES \
            and render_mode != "chars":
        fail(
            f"effect {args.effect!r} requires the chars renderer; choose a "
            "graphical effect for cells or half-block"
        )
    # One reveal animation may be active per run (the flags are mutually
    # exclusive); reveal_secs is its fill time, pulled from the matching knob.
    if args.rain:
        reveal_style = "rain"
        reveal_secs = args.rain_secs
    elif args.scatter:
        reveal_style = "scatter"
        reveal_secs = args.scatter_secs
    else:
        reveal_style = None
        reveal_secs = 0.0

    import numpy as np
    from yt_ascii_effects import EffectProcessor
    from yt_ascii_frames import EffectContext
    from yt_ascii_renderer import AnsiRenderer
    from yt_ascii_styles import StyleProcessor

    style_processor = StyleProcessor(args.style)
    args.style = style_processor.name
    style_processor.reset()  # each new media item starts with fresh style state
    effect_processor = EffectProcessor(
        getattr(args, "effect", "none"),
        glyph_mode=getattr(args, "effect_glyphs", "ascii"),
        speed=getattr(args, "effect_speed", 1.0),
        seed=getattr(args, "effect_seed", 0),
        effect_text=getattr(args, "effect_text", DEFAULT_EFFECT_TEXT),
    )
    args.effect = effect_processor.name
    effect_processor.reset("source")

    palette_name = "custom" if args.chars is not None else args.palette
    chars = args.chars if args.chars is not None else PALETTES[args.palette]
    if not chars:
        fail("palette must be non-empty")
    if "\x00" in chars:
        fail("palette cannot contain NUL")

    sys.stderr.write("Resolving stream…\n")
    try:
        if diagnostics is None:
            info = probe(args.url, args.max_res)
        else:
            with diagnostics.timer("probe", startup=True):
                info = probe(args.url, args.max_res)
    except ProbeError as e:
        if diagnostics is not None:
            diagnostics.event("probe_failure")
        fail(str(e))
    if diagnostics is not None:
        diagnostics.set_source_metadata(
            width=info["width"],
            height=info["height"],
            duration_seconds=info["duration"],
            live=info.get("is_live"),
            fps=info.get("fps"),
        )
    report_automatic_update(automatic_update_check)

    def compute_dims():
        """Read terminal size and derive output (cols, rows, ow, oh)."""
        c, r = shutil.get_terminal_size((80, 24))
        if args.width and args.height:
            return c, r, args.width, args.height
        if args.width:
            w = args.width
            h = max(1, round(w / (info["width"] / info["height"]) / CHAR_ASPECT))
            return c, r, w, h
        if args.height:
            h = args.height
            w = max(1, round(h * (info["width"] / info["height"]) * CHAR_ASPECT))
            return c, r, w, h
        w, h = fit_to_terminal(c, r, info["width"], info["height"])
        return c, r, w, h

    cols, rows, ow, oh = compute_dims()
    pix_h = oh * 2 if half_block else oh   # source-pixel height ffmpeg scales to
    if diagnostics is not None:
        diagnostics.set_output_geometry(
            width=ow, height=oh, target_fps=args.fps
        )

    mode_label = render_mode
    if requested_render != render_mode:
        mode_label = f"{requested_render}→{render_mode} (--no-color)"
    elif not color:
        mode_label += " grayscale"
    audio_enabled = not args.no_audio and bool(find_ffplay())
    audio_label = (
        "8-bit audio" if (audio_enabled and args.eight_bit)
        else ("audio" if audio_enabled else "no audio")
    )
    if diagnostics is not None:
        diagnostics.event(
            "audio_mode",
            success=audio_enabled,
            reason=(
                "eight_bit"
                if audio_enabled and args.eight_bit
                else "normal" if audio_enabled else "disabled"
            ),
        )
    sys.stderr.write(
        f"▶ {info['title']}\n"
        f"  source {info['width']}x{info['height']}  "
        f"→  terminal {ow}x{oh} cells @ {args.fps}fps  "
        f"({mode_label}, {audio_label})\n"
    )

    # Playback timeline:
    #   seek_pos = video time at the start of the current decoder segment
    #   seek_at  = wall clock when the current segment began
    # current playback position is therefore seek_pos + (now - seek_at)
    state = {"video": None, "audio": None}
    seek_pos = 0.0
    seek_at = time.monotonic()
    frame_no = 0          # frames consumed within current segment
    presented_sequence = 0
    paused = False
    pause_started = 0.0
    # Reveal animation: wall-clock time the current segment's reveal began
    # (set on the first rendered frame; None until then, and when disabled).
    reveal_start = None
    # The raw frame is retained as a zero-copy view of ``frame_buffer``. While
    # paused that buffer is stable, allowing an immediate style redraw without
    # restarting or advancing the decoder.
    last_frame = None
    last_frame_time = 0.0
    last_reveal_fraction = 1.0

    def current_pos():
        if paused:
            return seek_pos + (pause_started - seek_at)
        return seek_pos + (time.monotonic() - seek_at)

    def start_at(pos):
        if diagnostics is None:
            state["video"] = spawn_video(info, args.fps, ow, pix_h, pos)
        else:
            with diagnostics.timer("decoder_start"):
                state["video"] = spawn_video(
                    info, args.fps, ow, pix_h, pos, diagnostics
                )
            diagnostics.register_child(state["video"], "video")
        if audio_enabled:
            if diagnostics is None:
                state["audio"] = spawn_audio(info, pos, args.eight_bit)
            else:
                with diagnostics.timer("audio_start"):
                    state["audio"] = spawn_audio(
                        info, pos, args.eight_bit
                    )
                diagnostics.register_child(state["audio"], "audio")

    def stop_all():
        video = state["video"]
        audio = state["audio"]
        if diagnostics is not None:
            diagnostics.sample_resources(force=True)
            for role, child in (("video", video), ("audio", audio)):
                if child is None:
                    continue
                try:
                    child_exit_code = child.poll()
                except (AttributeError, OSError):
                    child_exit_code = None
                child_fields = {
                    "reason": role,
                    "success": child_exit_code is None,
                }
                if child_exit_code is not None:
                    child_fields["exit_code"] = child_exit_code
                diagnostics.event("child_before_stop", **child_fields)
        stop_procs(video, audio)
        consume_video_diagnostics(video, diagnostics)
        if diagnostics is not None:
            diagnostics.unregister_child(video)
            diagnostics.unregister_child(audio)
        state["video"] = state["audio"] = None

    def seek_to(new_pos):
        nonlocal seek_pos, seek_at, frame_no, presented_sequence, paused, last_frame
        if info["duration"]:
            new_pos = max(0.0, min(new_pos, info["duration"] - 0.5))
        else:
            new_pos = max(0.0, new_pos)
        stop_all()
        start_at(new_pos)
        seek_pos = new_pos
        seek_at = time.monotonic()
        frame_no = 0
        presented_sequence = 0
        paused = False  # resume on seek so the user sees the new position
        last_frame = None
        style_processor.reset()
        effect_processor.reset("seek")
        begin_reveal()  # replay the reveal from the new position
        if diagnostics is not None:
            diagnostics.increment("controls")
            diagnostics.event(
                "control", reason="seek", position_seconds=new_pos
            )

    def toggle_pause():
        nonlocal paused, pause_started, seek_at, reveal_start, seek_pos, frame_no
        if not paused:
            pause_started = time.monotonic()
            if _CAN_SUSPEND:
                signal_proc(state["video"], signal.SIGSTOP)
                signal_proc(state["audio"], signal.SIGSTOP)
            else:
                # No process-suspend (Windows): freeze the clock right here and
                # stop the decoders; we respawn from this spot on resume.
                seek_pos = current_pos()
                seek_at = pause_started     # current_pos() == seek_pos paused
                stop_all()
            paused = True
            if diagnostics is not None:
                diagnostics.increment("controls")
                diagnostics.event("control", reason="pause", paused=True)
        else:
            delta = time.monotonic() - pause_started
            if reveal_start is not None:
                reveal_start += delta       # keep the reveal frozen while paused
            if _CAN_SUSPEND:
                seek_at += delta
                signal_proc(state["video"], signal.SIGCONT)
                signal_proc(state["audio"], signal.SIGCONT)
            else:
                start_at(seek_pos)
                seek_at = time.monotonic()
                frame_no = 0
            paused = False
            if diagnostics is not None:
                diagnostics.increment("controls")
                diagnostics.event("control", reason="resume", paused=False)

    def do_resize():
        """Recompute output size and restart the video decoder in place.
        Audio is left running so there's no audible gap on resize."""
        nonlocal cols, rows, ow, oh, pix_h, frame_size
        nonlocal frame_buffer, discard_buffer, reveal_start
        nonlocal seek_pos, seek_at, frame_no, presented_sequence
        nonlocal pause_started, last_frame
        new_cols, new_rows, new_ow, new_oh = compute_dims()
        if (new_ow, new_oh, new_cols) == (ow, oh, cols):
            return
        resize_at = time.monotonic()
        pos = current_pos()
        if paused and reveal_start is not None:
            # Account for the paused interval before resetting pause_started;
            # resume will add the remainder after this resize.
            reveal_start += resize_at - pause_started
        cols, rows = new_cols, new_rows
        ow, oh = new_ow, new_oh
        pix_h = oh * 2 if half_block else oh
        if diagnostics is not None:
            diagnostics.set_output_geometry(
                width=ow, height=oh, target_fps=args.fps
            )
        frame_size = ow * pix_h * channels
        frame_buffer = bytearray(frame_size)
        discard_buffer = bytearray(frame_size)
        old_video = state["video"]
        if diagnostics is not None:
            diagnostics.sample_resources(force=True)
        stop_proc(old_video)
        consume_video_diagnostics(old_video, diagnostics)
        if diagnostics is not None:
            diagnostics.unregister_child(old_video)
        state["video"] = None
        # Windows pause stops the decoders instead of suspending them. Do not
        # spawn a decoder during a paused resize; resume will start exactly one.
        if not paused or _CAN_SUSPEND:
            if diagnostics is None:
                state["video"] = spawn_video(info, args.fps, ow, pix_h, pos)
            else:
                with diagnostics.timer("decoder_start"):
                    state["video"] = spawn_video(
                        info, args.fps, ow, pix_h, pos, diagnostics
                    )
                diagnostics.register_child(state["video"], "video")
        seek_pos = pos
        seek_at = resize_at
        frame_no = 0
        presented_sequence = 0
        last_frame = None
        style_processor.reset()
        effect_processor.reset("resize")
        if paused:
            pause_started = resize_at
            if _CAN_SUSPEND:
                signal_proc(state["video"], signal.SIGSTOP)
        if diagnostics is not None:
            diagnostics.increment("resizes")
            diagnostics.event(
                "resize", width=ow, height=oh
            )
        sys.stdout.write("\x1b[2J\x1b[H")  # clear; old frame had wrong dims
        sys.stdout.flush()
        # A reveal in progress just continues at the new size: its progress is
        # wall-clock based, so the scatter mask reshuffles to the new dims and
        # the rain reshuffles its columns to the new width on the next frame.

    retry = {"n": 0, "pos": -1.0}
    termination_reason = "end_of_stream"
    def recover_stream():
        """The video pipe closed before the end of the video. A close near the
        known end is a normal finish; otherwise the stream dropped (the
        googlevideo URL expired, or a network blip outlasted ffmpeg's own
        reconnect) — refresh the URL and resume from the last shown frame.
        Returns True if playback resumed, False if we should stop."""
        nonlocal seek_pos, seek_at, frame_no, paused, last_frame
        nonlocal termination_reason
        pos = seek_pos + frame_no * frame_dur
        dur = info["duration"]
        if dur and pos >= dur - 1.0:
            termination_reason = "end_of_stream"
            return False  # reached the end — a normal finish

        # Count consecutive failures at (roughly) the same spot so a truly
        # dead stream gives up instead of looping forever.
        if abs(pos - retry["pos"]) < 1.0:
            retry["n"] += 1
        else:
            retry["n"], retry["pos"] = 1, pos
        if retry["n"] > MAX_STREAM_RETRIES:
            termination_reason = "reconnect_exhausted"
            if diagnostics is not None:
                diagnostics.increment("reconnect_failures")
                diagnostics.event(
                    "reconnect", reason="exhausted", count=retry["n"]
                )
            return False

        if diagnostics is not None:
            diagnostics.increment("reconnects")
            diagnostics.event(
                "reconnect", reason="start", count=retry["n"]
            )
        sys.stdout.write(f"\x1b[{oh + 1};1H\x1b[0m  ⟳ reconnecting…\x1b[K")
        sys.stdout.flush()
        try:
            if diagnostics is None:
                info.update(probe(args.url, args.max_res))
            else:
                with diagnostics.timer("reconnect_probe"):
                    info.update(probe(args.url, args.max_res))
        except Exception:
            pass  # keep the old URL; recovery must never crash the player
        stop_all()
        start_at(pos)
        seek_pos, seek_at, frame_no, paused = pos, time.monotonic(), 0, False
        last_frame = None
        style_processor.reset()
        if diagnostics is not None:
            diagnostics.event(
                "reconnect", reason="resumed", count=retry["n"]
            )
        return True

    resize_flag = [False]
    def on_winch(*_):
        resize_flag[0] = True
    if hasattr(signal, "SIGWINCH"):
        signal.signal(signal.SIGWINCH, on_winch)

    # Put stdin in cbreak mode so we can read single keys without Enter.
    fd = sys.stdin.fileno()
    is_tty = os.isatty(fd)
    old_term = None

    frame_dur = 1.0 / args.fps
    channels = 3
    frame_size = ow * pix_h * channels
    frame_buffer = bytearray(frame_size)
    discard_buffer = bytearray(frame_size)

    try:
        rain_choice = validate_rain_chars(args.rain_chars)
    except (TypeError, ValueError) as error:
        fail(str(error))
    rain_chars = RAIN_CHARSETS.get(rain_choice, rain_choice)
    renderer = AnsiRenderer(
        chars,
        color=color,
        render_mode=render_mode,
        rain_chars=rain_chars,
    )

    def render_frame(
        frame, video_time, reveal_fraction, *, advance_state, sequence
    ):
        """Compose style, visual effect, reveal, then terminal bytes."""
        if diagnostics is None:
            styled = style_processor.apply(frame)
        else:
            with diagnostics.timer("style"):
                styled = style_processor.apply(frame)
        context = EffectContext(
            video_time=video_time,
            frame_sequence=sequence,
            cell_shape=(oh, ow),
            render_mode=render_mode,
            advance_state=advance_state,
        )
        if diagnostics is None:
            effected = effect_processor.apply(styled, context)
        else:
            with diagnostics.timer("effect"):
                effected = effect_processor.apply(styled, context)

        if diagnostics is None:
            if reveal_fraction < 1.0:
                reveal_method = (
                    renderer.render_rain
                    if reveal_style == "rain"
                    else renderer.render_scatter
                )
                if effected.cells is None:
                    return reveal_method(effected.rgb, reveal_fraction)
                return reveal_method(
                    effected.rgb, reveal_fraction, effected.cells
                )
            if effected.cells is None:
                return renderer.render(effected.rgb)
            return renderer.render(effected.rgb, effected.cells)
        with diagnostics.timer("ansi"):
            if reveal_fraction < 1.0:
                reveal_method = (
                    renderer.render_rain
                    if reveal_style == "rain"
                    else renderer.render_scatter
                )
                if effected.cells is None:
                    return reveal_method(effected.rgb, reveal_fraction)
                return reveal_method(
                    effected.rgb, reveal_fraction, effected.cells
                )
            if effected.cells is None:
                return renderer.render(effected.rgb)
            return renderer.render(effected.rgb, effected.cells)

    def redraw_paused_frame():
        """Render the retained raw frame with the current paused state."""
        if last_frame is None:
            return
        body = render_frame(
            last_frame,
            last_frame_time,
            last_reveal_fraction,
            advance_state=False,
            sequence=presented_sequence,
        )
        if diagnostics is None:
            status = build_status(
                args.fps, current_pos(), info, cols, paused=True,
                style=args.style, effect=args.effect,
                render_backend=mode_label,
                palette=active_palette_name(),
            )
            write_terminal_frame(body, status)
        else:
            with diagnostics.timer("status"):
                status = build_status(
                    args.fps, current_pos(), info, cols, paused=True,
                    style=args.style, effect=args.effect,
                    render_backend=mode_label,
                    palette=active_palette_name(),
                )
            diagnostics.increment(
                "output_bytes",
                write_terminal_frame(body, status, diagnostics),
            )

    def cycle_style():
        """Select the next style; the caller coordinates any paused redraw."""
        args.style = style_processor.cycle()
        effect_processor.reset("style")
        if diagnostics is not None:
            diagnostics.increment("controls")
            diagnostics.event(
                "control", reason="style", style=args.style
            )

    def cycle_effect():
        """Select the next backend-compatible effect without restarting."""
        args.effect = effect_processor.cycle(render_mode=render_mode)
        if diagnostics is not None:
            diagnostics.increment("controls")
            diagnostics.event(
                "control", reason="effect", effect=args.effect
            )

    def active_palette_name():
        """Return the label only while the renderer owns visible glyphs."""
        if render_mode != "chars" or args.effect in TEXT_EFFECT_NAMES:
            return None
        return palette_name

    def cycle_palette():
        """Change only character composition, preserving decode/effect state."""
        nonlocal palette_name
        if active_palette_name() is None:
            return False
        palette_name = _next_palette_name(palette_name)
        renderer.set_palette(PALETTES[palette_name])
        # Persist the visible selection across the interactive multi-video
        # loop. Once the user leaves a custom palette, cycling uses built-ins.
        args.chars = None
        args.palette = palette_name
        if diagnostics is not None:
            diagnostics.increment("controls")
            diagnostics.event(
                "control", reason="palette", palette=palette_name
            )
        return True

    def begin_reveal():
        """Start (or restart, after a seek) the current reveal animation: clear
        the screen so the picture builds on from nothing. The effect then grows
        in the render path, against the live frames. No-op when disabled."""
        nonlocal reveal_start
        reveal_start = None
        if reveal_style:
            renderer.reset_reveal()
            sys.stdout.write("\x1b[2J\x1b[H")
            sys.stdout.flush()

    try:
        if is_tty and not IS_WINDOWS:
            try:
                old_term = termios.tcgetattr(fd)
                tty.setcbreak(fd)
            except Exception:
                is_tty = False
        sys.stdout.write("\x1b[?25l\x1b[2J\x1b[H")
        sys.stdout.flush()
        start_at(0.0)
        # Pace from decoder startup rather than stream-probe time.
        seek_at = time.monotonic()
        begin_reveal()
        while True:
            loop_started = (
                time.monotonic() if diagnostics is not None else None
            )
            # ── Handle keyboard ──────────────────────────────────────────
            quit_now = False
            palette_changed = False
            style_changed = False
            effect_changed = False
            pending_seek = None  # final target after applying all queued keys
            if is_tty:
                for key in read_keys(fd):
                    if key == "q":
                        quit_now = True
                        termination_reason = "user_quit"
                        if diagnostics is not None:
                            diagnostics.increment("controls")
                            diagnostics.event("control", reason="quit")
                        break
                    if key == "space":
                        toggle_pause()
                        continue
                    if key == "s":
                        cycle_style()
                        style_changed = True
                        continue
                    if key == "e":
                        cycle_effect()
                        effect_changed = True
                        continue
                    if key == "p":
                        palette_changed = cycle_palette() or palette_changed
                        continue
                    base = pending_seek if pending_seek is not None else current_pos()
                    if key == "left":
                        pending_seek = base - 5
                    elif key == "right":
                        pending_seek = base + 5
                    elif key == "down":
                        pending_seek = base - 30
                    elif key == "up":
                        pending_seek = base + 30
                    elif key.isdigit() and info["duration"]:
                        pending_seek = info["duration"] * int(key) / 10
            if quit_now:
                break
            if pending_seek is not None:
                seek_to(pending_seek)
            # Key reads are batches. Redraw after the whole batch so both
            # ``space, s`` and ``s, space`` end with a correctly styled frozen
            # frame rather than a new label over the previous style.
            if (palette_changed or style_changed or effect_changed) and paused:
                redraw_paused_frame()

            if resize_flag[0]:
                resize_flag[0] = False
                do_resize()

            # ── Paused: just idle and keep the status line updating ─────
            if paused:
                pos = current_pos()
                if diagnostics is None:
                    status = build_status(
                        args.fps, pos, info, cols, paused=True,
                        style=args.style, effect=args.effect,
                        render_backend=mode_label,
                        palette=active_palette_name(),
                    )
                    sys.stdout.write(
                        f"\x1b[{oh + 1};1H" + status + "\x1b[K"
                    )
                    sys.stdout.flush()
                else:
                    with diagnostics.timer("status"):
                        status = build_status(
                            args.fps, pos, info, cols, paused=True,
                            style=args.style, effect=args.effect,
                            render_backend=mode_label,
                            palette=active_palette_name(),
                        )
                    paused_payload = (
                        f"\x1b[{oh + 1};1H" + status + "\x1b[K"
                    )
                    with diagnostics.timer("terminal_write"):
                        sys.stdout.write(paused_payload)
                        sys.stdout.flush()
                    diagnostics.increment(
                        "output_bytes", len(paused_payload.encode("utf-8"))
                    )
                time.sleep(0.05)
                if diagnostics is not None and diagnostics.tick():
                    termination_reason = "duration"
                    break
                continue

            # ── Drop frames if behind, to stay in sync with audio ───────
            now = time.monotonic()
            seg_elapsed = now - seek_at
            target = int(seg_elapsed * args.fps)
            dropped = 0
            if frame_no < target - 1:
                skip = target - frame_no - 1
                if diagnostics is None:
                    dropped = discard_frames(
                        state["video"].stdout, skip, discard_buffer
                    )
                else:
                    with diagnostics.timer("frame_drain"):
                        dropped = discard_frames(
                            state["video"].stdout, skip, discard_buffer
                        )
                frame_no += dropped
                if dropped != skip:
                    if diagnostics is not None:
                        diagnostics.increment("frames_dropped", dropped)
                        diagnostics.increment("decoder_eofs")
                        diagnostics.event(
                            "frame_drain_eof",
                            count=dropped,
                        )
                    if recover_stream():
                        continue
                    break

            if diagnostics is None:
                received = read_exact_into(
                    state["video"].stdout, frame_buffer
                )
            else:
                with diagnostics.timer("decoder_read"):
                    received = read_exact_into(
                        state["video"].stdout, frame_buffer
                    )
            if received != frame_size:
                if diagnostics is not None:
                    diagnostics.increment("decoder_eofs")
                    diagnostics.event(
                        "decoder_eof",
                        count=received,
                    )
                if recover_stream():
                    continue
                break

            frame = np.frombuffer(frame_buffer, dtype=np.uint8)
            frame = frame.reshape(pix_h, ow, 3)
            frame_time = seek_pos + frame_no * frame_dur

            # Reveal animations unmask the live frame over `reveal_secs`, timed
            # from the first frame actually shown (so a slow stream connect
            # doesn't eat the start of the effect).
            if reveal_style:
                rnow = time.monotonic()
                if reveal_start is None:
                    reveal_start = rnow
                frac = (rnow - reveal_start) / reveal_secs
            else:
                frac = 1.0
            body = render_frame(
                frame,
                frame_time,
                frac,
                advance_state=True,
                sequence=presented_sequence,
            )
            last_frame = frame
            last_frame_time = frame_time
            last_reveal_fraction = frac
            presented_sequence += 1

            pos = seek_pos + seg_elapsed
            if diagnostics is None:
                status = build_status(
                    args.fps, pos, info, cols, paused=False,
                    style=args.style, effect=args.effect,
                    render_backend=mode_label,
                    palette=active_palette_name(),
                )
                write_terminal_frame(body, status)
            else:
                with diagnostics.timer("status"):
                    status = build_status(
                        args.fps, pos, info, cols, paused=False,
                        style=args.style, effect=args.effect,
                        render_backend=mode_label,
                        palette=active_palette_name(),
                    )
                output_bytes = write_terminal_frame(
                    body, status, diagnostics
                )

            presented_at = (
                time.monotonic() if diagnostics is not None else None
            )
            if diagnostics is not None:
                first_presented_frame = presented_sequence == 1
                diagnostics.mark_first_frame()
                diagnostics.record_frame(
                    output_bytes=output_bytes,
                    dropped=dropped,
                    lateness_seconds=(
                        None
                        if first_presented_frame
                        else max(
                            0.0,
                            presented_at - (seek_at + frame_no * frame_dur),
                        )
                    ),
                    loop_seconds=(
                        None
                        if first_presented_frame
                        else presented_at - loop_started
                    ),
                )

            frame_no += 1
            delay = (seek_at + frame_no * frame_dur) - time.monotonic()
            if delay > 0:
                if diagnostics is None:
                    time.sleep(delay)
                else:
                    sleep_deadline = time.monotonic() + delay
                    time.sleep(delay)
                    diagnostics.record_timing(
                        "sleep_overshoot",
                        max(0.0, time.monotonic() - sleep_deadline),
                    )
            if diagnostics is not None and diagnostics.tick():
                termination_reason = "duration"
                break
    except KeyboardInterrupt:
        termination_reason = "keyboard_interrupt"
    finally:
        if diagnostics is None:
            stop_all()
            if old_term is not None and termios is not None:
                termios.tcsetattr(fd, termios.TCSADRAIN, old_term)
            sys.stdout.write("\x1b[0m\x1b[?25h\n")
            sys.stdout.flush()
        else:
            cleanup_started = time.monotonic()
            children = (state["video"], state["audio"])
            terminal_restored = True
            for role, child in zip(("video", "audio"), children):
                if child is None:
                    continue
                try:
                    child_exit_code = child.poll()
                except (AttributeError, OSError):
                    child_exit_code = None
                child_fields = {
                    "reason": role,
                    "success": child_exit_code is None,
                }
                if child_exit_code is not None:
                    child_fields["exit_code"] = child_exit_code
                diagnostics.event("child_before_cleanup", **child_fields)
            try:
                stop_all()
            finally:
                try:
                    if old_term is not None and termios is not None:
                        try:
                            termios.tcsetattr(
                                fd, termios.TCSADRAIN, old_term
                            )
                        except BaseException:
                            terminal_restored = False
                            raise
                finally:
                    try:
                        sys.stdout.write("\x1b[0m\x1b[?25h\n")
                        sys.stdout.flush()
                    except BaseException:
                        terminal_restored = False
                        raise
                    finally:
                        children_reaped = True
                        for child in children:
                            if child is None:
                                continue
                            try:
                                children_reaped &= child.poll() is not None
                            except (AttributeError, OSError):
                                children_reaped = False
                        diagnostics.record_cleanup(
                            time.monotonic() - cleanup_started,
                            children_reaped=children_reaped,
                            terminal_restored=terminal_restored,
                        )
    return termination_reason


def _terminal_cell_width(text):
    """Return a conservative terminal width using only the standard library."""
    width = 0
    for char in text:
        if unicodedata.combining(char) or unicodedata.category(char) in ("Cf", "Cc"):
            continue
        width += 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1
    return width


def _truncate_terminal_cells(text, limit):
    """Truncate text without splitting a character past the terminal edge."""
    result = []
    used = 0
    for char in text:
        if unicodedata.category(char) in ("Cf", "Cc"):
            continue
        char_width = _terminal_cell_width(char)
        if used + char_width > limit:
            break
        result.append(char)
        used += char_width
    return "".join(result)


def build_status(
    fps, pos, info, cols, paused, style="classic", effect="none",
    render_backend="chars", pixel_fallback=False, palette=None,
):
    if info["duration"]:
        clock = f"{fmt_time(pos)} / {fmt_time(info['duration'])}"
    else:
        clock = fmt_time(pos)
    tag = "‖ PAUSED" if paused else "▶"
    width = max(0, int(cols))
    effect_label = f"effect:{effect}"
    # ``pixel_fallback`` is retained only for programmatic callers from the old
    # interface; normal playback always supplies the explicit backend label.
    if pixel_fallback:
        render_backend = "half-block→chars"
    render_label = f"render:{render_backend}"
    palette_label = f"palette:{palette}" if palette is not None else None
    head_options = [
        f"  {tag}  {clock}  {fps}fps  {render_label}  style:{style}  "
        f"{effect_label}"
        + (f"  {palette_label}" if palette_label else ""),
        f"  {tag}  {clock}  {render_label}  style:{style}  {effect_label}"
        + (f"  {palette_label}" if palette_label else ""),
        f"  {render_label}  style:{style}  {effect_label}",
        f"  {clock}  {render_label}  {effect_label}",
        f"  {render_label}  {effect_label}",
        f"  {effect_label}",
    ]
    if palette_label:
        head_options.insert(
            2,
            f"  {render_label}  style:{style}  {effect_label}  "
            f"{palette_label}",
        )
        control_options = (
            "space:pause  p:palette  s:style  e:effect  ←→±5s  ↑↓±30s  "
            "0-9:jump  q:quit",
            "space:pause  p:palette  s:style  e:effect  arrows:seek  q:quit",
            "p:palette  s:style  e:effect  q:quit",
        )
    else:
        control_options = (
            "space:pause  s:style  e:effect  ←→±5s  ↑↓±30s  0-9:jump  q:quit",
            "space:pause  s:style  e:effect  arrows:seek  0-9:jump  q:quit",
            "space  s:style  e:effect  arrows:seek  q:quit",
            "s:style  e:effect  q:quit",
        )
    head = controls = fallback_head = ""
    title_reserve = min(12, _terminal_cell_width(info.get("title", "")))
    for reserve in ((title_reserve, 0) if title_reserve else (0,)):
        for candidate_head in head_options:
            candidate_width = _terminal_cell_width(candidate_head)
            if candidate_width > width:
                continue
            if not fallback_head:
                fallback_head = candidate_head
            candidate_controls = next(
                (
                    value for value in control_options
                    if candidate_width + 2 + _terminal_cell_width(value) + reserve
                    <= width
                ),
                "",
            )
            if candidate_controls:
                head, controls = candidate_head, candidate_controls
                break
        if controls:
            break
    if not head:
        head = fallback_head
    if not head:
        return "\x1b[0m" + _truncate_terminal_cells(head_options[-1], width)
    head_width = _terminal_cell_width(head)
    controls_width = _terminal_cell_width(controls) + 2 if controls else 0
    title_room = max(0, width - head_width - controls_width - 2)
    title = (
        _truncate_terminal_cells(info["title"], title_room)
        if title_room else ""
    )
    visible = head
    if title:
        visible += "  " + title
    if controls:
        visible += "  " + controls
    return "\x1b[0m" + _truncate_terminal_cells(visible, width)


def self_test():
    """Exercise every retained style, effect, and backend offline."""
    import numpy as np
    from yt_ascii_effects import (
        DEFAULT_EFFECT_TEXT as IMPLEMENTED_DEFAULT_EFFECT_TEXT,
        EFFECT_ALIASES as IMPLEMENTED_ALIASES,
        EFFECT_NAMES as IMPLEMENTED_EFFECTS,
        EFFECT_SPECS,
        TEXT_EFFECT_NAMES as IMPLEMENTED_TEXT_EFFECTS,
        EffectProcessor,
    )
    from yt_ascii_frames import EffectContext
    from yt_ascii_renderer import AnsiRenderer, BG, HALF_BLOCK
    from yt_ascii_styles import (
        STYLE_ALIASES as IMPLEMENTED_STYLE_ALIASES,
        STYLE_NAMES as IMPLEMENTED_STYLES,
        StyleProcessor,
    )

    if tuple(IMPLEMENTED_STYLES) != STYLE_NAMES:
        fail("style registry self-test failed")
    if dict(IMPLEMENTED_STYLE_ALIASES) != STYLE_ALIASES:
        fail("style alias registry self-test failed")
    if IMPLEMENTED_DEFAULT_EFFECT_TEXT != DEFAULT_EFFECT_TEXT:
        fail("effect text default self-test failed")
    if tuple(IMPLEMENTED_EFFECTS) != EFFECT_NAMES:
        fail("effect registry self-test failed")
    if dict(IMPLEMENTED_ALIASES) != EFFECT_ALIASES:
        fail("effect alias registry self-test failed")
    if frozenset(IMPLEMENTED_TEXT_EFFECTS) != TEXT_EFFECT_NAMES:
        fail("text effect registry self-test failed")
    if tuple(spec.name for spec in EFFECT_SPECS) != EFFECT_NAMES:
        fail("effect metadata self-test failed")

    pixel = np.array([[[1, 2, 3]]], dtype=np.uint8)
    expected = b"\x1b[38;2;1;2;3mx\x1b[0m\x1b[K"
    if AnsiRenderer("x", render_mode="chars").render(pixel) != expected:
        fail("chars renderer self-test failed")
    cells_output = AnsiRenderer(render_mode="cells").render(pixel)
    if BG not in cells_output or not cells_output.endswith(b" \x1b[0m\x1b[K"):
        fail("cells renderer self-test failed")
    half_output = AnsiRenderer(render_mode="half-block").render(
        np.repeat(pixel, 2, axis=0)
    )
    if HALF_BLOCK not in half_output:
        fail("half-block renderer self-test failed")

    rows, cols = np.indices((18, 24), dtype=np.uint16)
    sample = np.stack(
        (
            (cols * 37 + rows * 17) % 256,
            (cols * 11 + rows * 53) % 256,
            ((cols ^ rows) * 29) % 256,
        ),
        axis=2,
    ).astype(np.uint8)
    style_processor = StyleProcessor()
    for name in STYLE_NAMES:
        style_processor.select(name)
        styled = style_processor.apply(sample)
        if styled.shape != sample.shape or styled.dtype != np.uint8:
            fail(f"{name} style self-test failed")

    renderers = {
        "chars": AnsiRenderer(" .#", render_mode="chars"),
        "cells": AnsiRenderer(render_mode="cells"),
        "half-block": AnsiRenderer(render_mode="half-block"),
    }
    for spec in EFFECT_SPECS:
        for render_mode in spec.compatible_renderers:
            source = (
                np.repeat(sample, 2, axis=0)
                if render_mode == "half-block"
                else sample
            )
            processor = EffectProcessor(
                spec.name, seed=7, effect_text="CODEX"
            )
            context = EffectContext(
                video_time=0.25,
                frame_sequence=0,
                cell_shape=sample.shape[:2],
                render_mode=render_mode,
                advance_state=True,
            )
            effected = processor.apply(source, context)
            if effected.rgb.dtype != np.uint8 or effected.rgb.shape != source.shape:
                fail(f"{spec.name}/{render_mode} effect self-test failed")
            if (effected.cells is not None) != (spec.name in TEXT_EFFECT_NAMES):
                fail(f"{spec.name}/{render_mode} cell-plane self-test failed")
            output = renderers[render_mode].render(
                effected.rgb, effected.cells
            )
            if not output or b"\x00" in output:
                fail(f"{spec.name}/{render_mode} renderer self-test failed")
            if render_mode == "cells" and (
                BG not in output or HALF_BLOCK in output
            ):
                fail(f"{spec.name} cells visual-contract self-test failed")

    for name in TEXT_EFFECT_NAMES:
        context = EffectContext(0.25, 0, sample.shape[:2], "chars")
        effected = EffectProcessor(
            name, glyph_mode="unicode", effect_text="CODEX"
        ).apply(sample, context)
        if effected.cells is None or not renderers["chars"].render(
            effected.rgb, effected.cells
        ):
            fail(f"{name} Unicode text self-test failed")

    gray_renderer = AnsiRenderer(
        " .#", color=False, render_mode="chars"
    )
    gray_style = StyleProcessor("edge-glow").apply(sample)
    gray_output = gray_renderer.render(gray_style)
    try:
        gray_output.decode("ascii")
    except UnicodeDecodeError:
        fail("Unicode-free grayscale self-test failed")
    sys.stdout.write("yt-ascii self-test: ok\n")


def run_update_action(args):
    """Run an explicit managed-install check/update before app dependencies."""
    if args.url is not None:
        fail("--update and --check-update cannot be combined with a video URL")
    try:
        import yt_ascii_update
    except Exception as error:
        sys.stderr.write(
            f"yt-ascii: updater module is unavailable or invalid: {error}\n"
        )
        sys.stderr.flush()
        return 1

    update_error = getattr(yt_ascii_update, "UpdateError", None)
    try:
        installation = yt_ascii_update.discover_install()
        if args.check_update:
            status = yt_ascii_update.check_for_update(
                installation, timeout=10.0
            )
            stream = sys.stdout if status.ok and status.supported else sys.stderr
            stream.write(f"yt-ascii: {status.display}\n")
            stream.flush()
            return 0 if status.ok and status.supported else 1
        return yt_ascii_update.delegate_update(installation)
    except Exception as error:
        expected = (
            isinstance(update_error, type)
            and issubclass(update_error, Exception)
            and isinstance(error, update_error)
        )
        message = str(error) if expected else f"updater failed: {error}"
        sys.stderr.write(f"yt-ascii: {message}\n")
        sys.stderr.flush()
        return 1


def start_automatic_update(args):
    """Start one silent best-effort channel check for a normal player launch."""
    if (
        getattr(args, "no_update_check", False)
        or os.environ.get("YTASCII_NO_UPDATE_CHECK") == "1"
    ):
        return None
    try:
        import yt_ascii_update
        installation = yt_ascii_update.discover_install()
        return yt_ascii_update.start_auto_check(installation, timeout=2.0)
    except Exception:
        return None


def report_automatic_update(check):
    """Print an available-update notice if a background check already finished."""
    if check is None:
        return
    try:
        status = check.consume()
    except Exception:
        return
    if status is not None:
        sys.stderr.write(
            f"yt-ascii: {status.display}; run yt-ascii --update\n"
        )
        sys.stderr.flush()


def main():
    _enable_windows_ansi()
    args = parse_args()
    if getattr(args, "update", False) or getattr(args, "check_update", False):
        raise SystemExit(run_update_action(args))
    automatic_update_check = (
        None if args.self_test else start_automatic_update(args)
    )
    check_deps()
    if args.self_test:
        self_test()
        return
    interactive = args.url is None
    while True:
        if interactive:
            args.url = prompt_for_url()      # exits the program on q / Ctrl-D
        if automatic_update_check is None:
            run(args)
        else:
            run(args, automatic_update_check)
        if not interactive:
            return


if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        sys.stdout.write("\x1b[0m\x1b[?25h\n")
