APP_VERSION = "0.5.0"
INSTALL_REF_ENV = "YTASCII_INSTALL_REF"
_MAX_INSTALL_REF_LENGTH = 64
_VERSION_REF_RE = re.compile(
    r"v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\Z"
)

# Single-key terminal input is POSIX-only (termios/tty + select on stdin). On
# Windows we read the console through msvcrt instead; if neither is available
# the video still plays, just without the interactive pause/seek keys.
IS_WINDOWS = os.name == "nt"
if not IS_WINDOWS:
    import select
    import termios
    import tty
    msvcrt = None
else:                                       # pragma: no cover - Windows only
    select = termios = tty = None
    try:
        import msvcrt
    except ImportError:
        msvcrt = None

# os.kill(pid, SIGSTOP/SIGCONT) gives a gap-free pause, but those signals don't
# exist on Windows; there we fall back to stopping and respawning the decoders.
_CAN_SUSPEND = hasattr(signal, "SIGSTOP") and hasattr(signal, "SIGCONT")

