# Terminal character cells are ~2x taller than wide; correct aspect ratio.
CHAR_ASPECT = 2.0

# Upper bound for --fps. Picked so that:
#   - YouTube: ≥99% of content tops out at 60 fps; higher values just duplicate
#     frames out of ffmpeg's fps filter, no visible benefit.
#   - Terminal: even GPU-accelerated terminals (alacritty/kitty/foot) start
#     dropping frames above this for full-window truecolor output.
MAX_FPS = 60

# Consecutive failed reconnects (at the same position) before we treat the
# stream as genuinely dead and stop.
MAX_STREAM_RETRIES = 3

# --scatter: default seconds for the random pop-in reveal to fill the screen.
# Cells appear one-by-one in a shuffled order — characters spraying in from
# random spots until the picture is complete — so this wants to be short and
# snappy ("rapidly", per the effect). The video plays live behind it the whole
# time. Override with --scatter-secs.
SCATTER_SECS = 4.0

# --rain: default seconds for the Matrix-style rain reveal to fill the screen.
# The staggered columns finish over the back half of the window, so a slightly
# wider window reads better; this also sets how fast the glyphs fall (longer =
# slower). Override with --rain-secs.
RAIN_SECS = 7.5

# Glyph sets the --rain reveal can draw from, selected with --rain-chars. A fresh
# glyph is picked per cell each frame so the streaks shimmer like Matrix "digital
# rain". Every glyph MUST be a single terminal cell wide or the columns drift, so
# these are limited to single-width, left-to-right, non-combining scripts. That
# rules out double-width CJK (Han + full-width kana/Hangul) and RTL/combining
# scripts (Arabic, Hebrew, Thai, Devanagari…) — they'd ripple the columns. Korean
# and Japanese therefore use their HALF-width forms (jamo / katakana). Greek and
# Cyrillic are East-Asian-"ambiguous" width: one cell in a normal terminal, two
# only in a CJK locale set to ambiguous=wide. `matrix` is the default; `polyglot`
# mixes every aligned script (letters), and `all` is the whole alphabet — every
# preset unioned, symbols included. --rain-chars also takes a literal custom
# string, so the presets are just convenient names.
def _chars(*ranges):
    """Expand (lo, hi) inclusive Unicode codepoint ranges into a glyph string."""
    return "".join(chr(cp) for lo, hi in ranges for cp in range(lo, hi + 1))

_DIGITS   = "0123456789"
_LATIN    = _chars((0x41, 0x5A), (0x61, 0x7A))                # A-Z a-z
_KATAKANA = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ"   # half-width
_CYRILLIC = _chars((0x410, 0x44F))                           # А-я  (Russian)
_GREEK    = _chars((0x391, 0x3A1), (0x3A3, 0x3A9), (0x3B1, 0x3C9))  # Α-Ω α-ω (3A2 reserved)
_ARMENIAN = _chars((0x531, 0x556), (0x561, 0x586))           # Ա-Ֆ ա-ֆ
_GEORGIAN = _chars((0x10D0, 0x10F0))                         # ა-ჰ  (Mkhedruli)
_HANGUL   = _chars((0xFFA1, 0xFFBE), (0xFFC2, 0xFFC7),       # half-width jamo
                   (0xFFCA, 0xFFCF), (0xFFD2, 0xFFD7), (0xFFDA, 0xFFDC))

RAIN_CHARSETS = {
    "matrix":   _DIGITS + _KATAKANA + ":.=+*<>|/",
    "katakana": _KATAKANA,
    "english":  _LATIN + _DIGITS,
    "russian":  _CYRILLIC,
    "greek":    _GREEK,
    "armenian": _ARMENIAN,
    "georgian": _GEORGIAN,
    "korean":   _HANGUL,
    "polyglot": (_LATIN + _CYRILLIC + _GREEK + _ARMENIAN + _GEORGIAN
                 + _KATAKANA + _HANGUL + _DIGITS),
}
# `all` = the entire rain alphabet: every glyph from every preset above, deduped.
RAIN_CHARSETS["all"] = "".join(sorted(set("".join(RAIN_CHARSETS.values()))))
DEFAULT_RAIN_CHARS = "matrix"

# Let ffmpeg/ffplay ride out transient googlevideo failures — expired URL
# segments, 403/5xx throttling, TCP/TLS resets — instead of exiting, which
# otherwise shows up as the video never starting or cutting off partway
# through. These are input options, so they must precede -i / the input URL.
#   delay_max        - cap the wait between retries (exponential backoff)
#   delay_total_max  - after this many seconds of cumulative retrying, let
#                      ffmpeg give up so our own recover_stream() can show a
#                      "reconnecting…" hint and fetch a fresh URL, rather than
#                      freezing on a stale frame for minutes (ffmpeg's default
#                      total budget is 256s).
RECONNECT_FLAGS = [
    "-reconnect", "1",
    "-reconnect_streamed", "1",
    "-reconnect_on_network_error", "1",
    "-reconnect_on_http_error", "4xx,5xx",
    "-reconnect_delay_max", "5",
    "-reconnect_delay_total_max", "30",
]

# yt-dlp player clients to try (in order) when resolving YouTube streams.
# YouTube increasingly bot-checks the default web client from datacenter/VM IPs
# ("Sign in to confirm you're not a bot"); the android_vr client sidesteps that
# and rarely needs sign-in. Plain `android` is kept alongside it because some
# studio / DRM-gated uploads (e.g. Apple TV+ or Paramount clips) report "This
# video is not available" to android_vr/web/ios yet still serve a plain
# progressive stream to the `android` client. web/ios remain last-resort
# fallbacks. yt-dlp merges the formats found across all listed clients.
YOUTUBE_CLIENTS = ["android_vr", "android", "web", "ios"]


class ProbeError(Exception):
    """Raised when yt-dlp can't resolve a usable stream."""


def fps_type(value):
    """argparse type for --fps. Accepts an int in [1, MAX_FPS] or the
    literal 'max'."""
    if value.lower() == "max":
        return MAX_FPS
    try:
        n = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"--fps must be an integer 1..{MAX_FPS} or 'max' (got {value!r})"
        )
    if n < 1:
        raise argparse.ArgumentTypeError("--fps must be at least 1")
    if n > MAX_FPS:
        raise argparse.ArgumentTypeError(
            f"--fps {n} exceeds the maximum of {MAX_FPS}; "
            f"use '--fps max' to request the cap"
        )
    return n


def effect_speed_type(value):
    """Validate the shared multiplier used by animated effects."""
    try:
        speed = float(value)
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"--effect-speed must be a positive number (got {value!r})"
        )
    if not (0.0 < speed < float("inf")):
        raise argparse.ArgumentTypeError(
            "--effect-speed must be a positive finite number"
        )
    return speed


def fail(msg, code=1):
    sys.stderr.write(f"yt-ascii: {msg}\n")
    sys.exit(code)


def _bundle_dir():
    """Directory PyInstaller unpacks bundled files into (and where we look for a
    bundled ffmpeg/ffplay), or None when running from source."""
    return getattr(sys, "_MEIPASS", None)


def _bundled_tool(name):
    """Path to a binary shipped inside the frozen app (via --add-binary), or
    None. `name` is the base name; the .exe variant is tried too (Windows)."""
    d = _bundle_dir()
    if not d:
        return None
    for cand in (os.path.join(d, name + ".exe"), os.path.join(d, name)):
        if os.path.isfile(cand):
            return cand
    return None


@functools.lru_cache(maxsize=None)
def find_ffmpeg():
    """Locate an ffmpeg binary. A system ffmpeg is preferred: it is dynamically
    linked and resolves DNS reliably, whereas the statically linked build we can
    bundle can fail name resolution on some hosts. It is still the fallback for
    machines that have no ffmpeg at all. Order:
        $YTASCII_FFMPEG -> system PATH -> bundled -> imageio-ffmpeg's build."""
    env = os.environ.get("YTASCII_FFMPEG")
    if env and os.path.isfile(env):
        return env
    sys_exe = shutil.which("ffmpeg")
    if sys_exe:
        return sys_exe
    bundled = _bundled_tool("ffmpeg")
    if bundled:
        return bundled
    try:
        import imageio_ffmpeg
        exe = imageio_ffmpeg.get_ffmpeg_exe()
        if exe and os.path.isfile(exe):
            if not os.access(exe, os.X_OK):
                try:
                    os.chmod(exe, 0o755)
                except OSError:
                    pass
            return exe
    except Exception:
        pass
    return None


@functools.lru_cache(maxsize=None)
def find_ffplay():
    """Locate ffplay for audio: $YTASCII_FFPLAY -> system PATH -> bundled.
    imageio-ffmpeg doesn't ship ffplay, so None ⇒ play silently."""
    env = os.environ.get("YTASCII_FFPLAY")
    if env and os.path.isfile(env):
        return env
    sys_exe = shutil.which("ffplay")
    if sys_exe:
        return sys_exe
    return _bundled_tool("ffplay")


def _popen_kwargs():
    """Keep ffmpeg/ffplay from flashing a console window on Windows."""
    if IS_WINDOWS:
        return {"creationflags": getattr(subprocess, "CREATE_NO_WINDOW", 0)}
    return {}


def _enable_windows_ansi():
    """Enable ANSI escape processing and UTF-8 output in the Windows console so
    color and the block/katakana glyphs render. No-op on other platforms."""
    if not IS_WINDOWS:
        return
    try:
        import ctypes
        kernel32 = ctypes.windll.kernel32
        handle = kernel32.GetStdHandle(-11)            # STD_OUTPUT_HANDLE
        mode = ctypes.c_uint32()
        if kernel32.GetConsoleMode(handle, ctypes.byref(mode)):
            kernel32.SetConsoleMode(handle, mode.value | 0x0004)  # VT processing
    except Exception:
        pass
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8")
        except Exception:
            pass


def have_ytdlp():
    """True if yt-dlp is usable, as a library (preferred, bundled) or a CLI."""
    try:
        import yt_dlp  # noqa: F401
        return True
    except ImportError:
        return bool(shutil.which("yt-dlp"))


def check_deps():
    missing = []
    if find_ffmpeg() is None:
        missing.append(("ffmpeg", "install ffmpeg, or: pip install imageio-ffmpeg"))
    if not have_ytdlp():
        missing.append(("yt-dlp", "pip install yt-dlp (or your package manager)"))
    try:
        import numpy  # noqa: F401
    except ImportError:
        missing.append(("numpy", "pip install numpy"))
    if missing:
        lines = "\n".join(f"  - {n}: {c}" for n, c in missing)
        fail(f"missing dependencies:\n{lines}")


def _probe_info(url, fmt):
    """Fetch yt-dlp's info dict for `url`, via the Python API when it's
    importable (the packaged build bundles it), else the yt-dlp CLI."""
    try:
        import yt_dlp
    except ImportError:
        yt_dlp = None
    if yt_dlp is not None:
        opts = {"format": fmt, "quiet": True, "no_warnings": True,
                "noplaylist": True, "skip_download": True,
                "extractor_args": {"youtube": {"player_client": YOUTUBE_CLIENTS}}}
        try:
            with yt_dlp.YoutubeDL(opts) as ydl:
                info = ydl.extract_info(url, download=False)
        except Exception as e:
            raise ProbeError(f"yt-dlp failed: {e}")
        if info is None:
            raise ProbeError("yt-dlp returned no metadata")
        return info
    exe = shutil.which("yt-dlp")
    if not exe:
        raise ProbeError("yt-dlp not found")
    meta = subprocess.run(
        [exe, "-f", fmt, "-j", "--no-warnings", "--no-playlist",
         "--extractor-args", "youtube:player_client=" + ",".join(YOUTUBE_CLIENTS),
         url],
        capture_output=True, text=True,
    )
    if meta.returncode != 0:
        raise ProbeError(f"yt-dlp failed:\n{meta.stderr.strip()}")
    try:
        return json.loads(meta.stdout.splitlines()[0])
    except (json.JSONDecodeError, IndexError):
        raise ProbeError("yt-dlp returned no metadata")


def probe(url, max_h):
    fmt = (f"bestvideo[height<={max_h}][vcodec!=none]+bestaudio[acodec!=none]/"
           f"best[height<={max_h}]")
    info = _probe_info(url, fmt)

    # When yt-dlp picks "bestvideo+bestaudio" it lists both in requested_formats;
    # for a single combined format the URL sits at the top level.
    formats = info.get("requested_formats") or []
    if formats:
        video_url = formats[0].get("url")
        audio_url = (formats[1].get("url") if len(formats) > 1 else None) or video_url
        if formats[0].get("vcodec") == "none" and len(formats) > 1:
            video_url, audio_url = audio_url, video_url
    else:
        video_url = info.get("url")
        audio_url = video_url
    if not video_url:
        raise ProbeError("yt-dlp did not return a stream URL")

    return {
        "title":    info.get("title", "?"),
        "width":    int(info.get("width") or 16),
        "height":   int(info.get("height") or 9),
        "duration": float(info.get("duration") or 0),
        "video":    video_url,
        "audio":    audio_url,
    }


def fit_to_terminal(cols, rows, vw, vh):
    rows = max(rows - 1, 1)
    aspect = vw / vh
    w = cols
    h = max(1, round(w / aspect / CHAR_ASPECT))
    if h > rows:
        h = rows
        w = max(1, round(h * aspect * CHAR_ASPECT))
    return w, h


def fmt_time(seconds):
    s = max(0, int(seconds))
    m, s = divmod(s, 60)
    h, m = divmod(m, 60)
    return f"{h:d}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"


# ── Keyboard input ────────────────────────────────────────────────────────────
ARROWS = {"A": "up", "B": "down", "C": "right", "D": "left"}


def read_keys(fd):
    """Drain pending keypresses into a list of key names (cross-platform)."""
    if IS_WINDOWS:
        return _read_keys_windows()
    return _read_keys_posix(fd)


def _read_keys_windows():
    keys = []
    if msvcrt is None:
        return keys
    arrows = {"H": "up", "P": "down", "K": "left", "M": "right"}
    while msvcrt.kbhit():
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):          # arrow / function-key prefix
            code = msvcrt.getwch()
            if code in arrows:
                keys.append(arrows[code])
            continue
        if ch == " ":
            keys.append("space")
        elif ch in "qQ\x03":
            keys.append("q")
        elif ch == "\x1b":
            keys.append("esc")
        elif ch == "s":
            keys.append("s")
        elif ch == "e":
            keys.append("e")
        elif ch.isdigit():
            keys.append(ch)
    return keys


def _read_keys_posix(fd):
    """Drain any pending key bytes from stdin into a list of key names."""
    keys = []
    while True:
        r, _, _ = select.select([fd], [], [], 0)
        if not r:
            return keys
        try:
            data = os.read(fd, 64).decode("utf-8", errors="replace")
        except OSError:
            return keys
        if not data:
            return keys
        i = 0
        while i < len(data):
            ch = data[i]
            # ESC '[' <letter>  → arrow keys
            if ch == "\x1b" and i + 2 < len(data) and data[i + 1] == "[":
                arrow = ARROWS.get(data[i + 2])
                if arrow:
                    keys.append(arrow)
                    i += 3
                    continue
                i += 1
                continue
            if ch == "\x1b":
                keys.append("esc"); i += 1; continue
            if ch == " ":
                keys.append("space"); i += 1; continue
            if ch in "qQ\x03":  # Ctrl-C as well
                keys.append("q"); i += 1; continue
            if ch == "s":
                keys.append("s"); i += 1; continue
            if ch == "e":
                keys.append("e"); i += 1; continue
            if ch.isdigit():
                keys.append(ch); i += 1; continue
            i += 1


# ── Process management for video + audio ──────────────────────────────────────
def spawn_video(info, fps, ow, oh, pos):
    cmd = [find_ffmpeg(), "-loglevel", "quiet"]
    cmd += RECONNECT_FLAGS
    if pos > 0:
        cmd += ["-ss", f"{pos:.3f}"]
    cmd += [
        "-i", info["video"], "-an",
        "-f", "rawvideo", "-pix_fmt", "rgb24",
        "-vf", f"fps={fps},scale={ow}:{oh}:flags=fast_bilinear",
        "-",
    ]
    return subprocess.Popen(cmd, stdout=subprocess.PIPE, **_popen_kwargs())


def spawn_audio(info, pos, eight_bit=False):
    cmd = [find_ffplay(), "-nodisp", "-autoexit", "-loglevel", "quiet"]
    cmd += RECONNECT_FLAGS
    if pos > 0:
        cmd += ["-ss", f"{pos:.3f}"]
    if eight_bit:
        # Retro chiptune chain:
        #   aresample=22050      - chop the upper octave (no airy hi-hats)
        #   pan=mono|...         - sum L+R; classic 8-bit hardware was mono
        #   acrusher bits=4      - quantize to 4 bits (16 levels — matches
        #                          NES DPCM / Game Boy waveform RAM, much
        #                          coarser than the prior 8-bit pass)
        #   samples=4            - sample-and-hold every 4 samples, giving
        #                          the stepped, aliased "old DAC" sound
        cmd += [
            "-af",
            "aresample=22050,pan=mono|c0=0.5*c0+0.5*c1,"
            "acrusher=bits=4:mix=1:mode=log:samples=4",
        ]
    cmd.append(info["audio"])
    return subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        **_popen_kwargs(),
    )


def stop_procs(*processes):
    """Resume, terminate and reap children against one shared deadline.

    A SIGTERM remains pending while a POSIX child is SIGSTOP'd, so seeking or
    quitting from pause used to wait one second per decoder before killing it.
    Resuming every live child first and terminating the group before waiting
    makes teardown both quick and bounded.
    """
    live = []
    for process in processes:
        if process is None:
            continue
        try:
            if process.poll() is None:
                live.append(process)
        except (AttributeError, OSError):
            live.append(process)
    if not live:
        return

    if _CAN_SUSPEND:
        for process in live:
            signal_proc(process, signal.SIGCONT)
    for process in live:
        try:
            process.terminate()
        except OSError:
            pass

    deadline = time.monotonic() + 1.0
    survivors = []
    for process in live:
        try:
            process.wait(timeout=max(0.0, deadline - time.monotonic()))
        except (OSError, subprocess.TimeoutExpired):
            survivors.append(process)
    for process in survivors:
        try:
            process.kill()
        except OSError:
            pass
    # Always reap killed children; keep this cleanup bounded as well.
    reap_deadline = time.monotonic() + 0.25
    for process in survivors:
        try:
            process.wait(timeout=max(0.0, reap_deadline - time.monotonic()))
        except (OSError, subprocess.TimeoutExpired):
            pass


def stop_proc(process):
    stop_procs(process)


def signal_proc(p, sig):
    if p is None:
        return
    try:
        os.kill(p.pid, sig)
    except OSError:
        pass


def read_exact_into(stream, buffer):
    """Fill ``buffer`` from a binary stream, tolerating short reads.

    Returns the number of bytes copied. A result smaller than ``len(buffer)``
    means EOF. The caller owns the reusable bytearray, so successful reads do
    not allocate a new frame-sized ``bytes`` object.
    """
    view = memoryview(buffer)
    offset = 0
    while offset < len(view):
        count = stream.readinto(view[offset:])
        if not count:
            break
        offset += count
    return offset


def discard_frames(stream, count, scratch):
    """Drain at most ``count`` complete frames using one bounded buffer."""
    complete = 0
    for _ in range(count):
        if read_exact_into(stream, scratch) != len(scratch):
            break
        complete += 1
    return complete


def write_terminal_frame(body, status):
    """Write one already-composed UTF-8 frame, with a text-stream fallback."""
    payload = b"".join(
        (b"\x1b[H", body, b"\n", status.encode("utf-8"), b"\x1b[K")
    )
    binary = getattr(sys.stdout, "buffer", None)
    if binary is None:
        sys.stdout.write(payload.decode("utf-8"))
        sys.stdout.flush()
        return
    binary.write(payload)
    binary.flush()


# ── Main ──────────────────────────────────────────────────────────────────────
def version_text():
    """Return the public version plus trusted installer provenance.

    Install launchers may identify either an immutable ``vX.Y.Z`` source ref
    or the rolling ``edge`` channel. Any other environment value is ignored so
    control characters and unbounded text can never reach the terminal.
    """
    install_ref = os.environ.get(INSTALL_REF_ENV, "")
    valid_ref = (
        len(install_ref) <= _MAX_INSTALL_REF_LENGTH
        and (
            install_ref == "edge"
            or _VERSION_REF_RE.fullmatch(install_ref) is not None
        )
    )
    if not valid_ref:
        install_ref = "source"
    return f"yt-ascii {APP_VERSION} ({install_ref})"


def parse_args():
    p = argparse.ArgumentParser(
        prog="yt-ascii",
        description="Watch YouTube videos as ASCII art in the terminal.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Keys while playing:\n"
            "  space        pause / resume\n"
            "  s            cycle visual style\n"
            "  e            cycle structural effect\n"
            "  ←/→          seek ±5s\n"
            "  ↓/↑          seek ±30s\n"
            "  0..9         jump to 0%..90%\n"
            "  q / Ctrl-C   quit"
        ),
    )
    p.add_argument("--version", action="version", version=version_text())
    maintenance = p.add_mutually_exclusive_group()
    maintenance.add_argument(
        "--update",
        action="store_true",
        help="update this managed installation on its current channel",
    )
    maintenance.add_argument(
        "--check-update",
        action="store_true",
        help="check the current installation channel for an update",
    )
    p.add_argument(
        "--no-update-check",
        action="store_true",
        help="skip the automatic update check for this player launch",
    )
    p.add_argument("url", nargs="?",
                   help="YouTube URL or video ID. Omit it to get a simple "
                        "interactive prompt where you can paste a link.")
    p.add_argument("--no-color", action="store_true",
                   help="render in grayscale (default is 24-bit color)")
    p.add_argument("--no-audio", action="store_true",
                   help="disable audio playback")
    p.add_argument("--8bit", dest="eight_bit", action="store_true",
                   help="bit-crush the audio (≈8-bit, 11kHz) for a retro "
                        "chiptune sound; no effect with --no-audio")
    p.add_argument("--pixels", action="store_true",
                   help="render with half-block pixels (▀) instead of ASCII "
                        "characters — packs two colored pixels per cell, "
                        "giving 2x vertical resolution and a sharper image. "
                        "Glyph effects temporarily switch to character cells; "
                        "ignored when --no-color is set.")
    reveal = p.add_mutually_exclusive_group()
    reveal.add_argument("--scatter", action="store_true",
                        help="reveal the picture with a random pop-in: ASCII "
                             "characters appear one-by-one from random positions, "
                             "rapidly filling the screen (re-scatters after each "
                             "seek)")
    reveal.add_argument("--rain", action="store_true",
                        help="reveal the picture with a Matrix-style rain: "
                             "white glyphs cascade down each column and the "
                             "live picture settles in behind them (re-rains "
                             "after each seek)")
    p.add_argument("--scatter-secs", type=float, default=SCATTER_SECS, metavar="S",
                   help=f"seconds for the --scatter reveal to fill the "
                        f"screen (default: {SCATTER_SECS:g})")
    p.add_argument("--rain-secs", type=float, default=RAIN_SECS, metavar="S",
                   help=f"seconds for the --rain reveal to fill the screen "
                        f"(default: {RAIN_SECS:g})")
    p.add_argument("--rain-chars", default=DEFAULT_RAIN_CHARS, metavar="SET",
                   help=f"glyphs for the --rain reveal: a preset "
                        f"({', '.join(RAIN_CHARSETS)}) or a custom string of "
                        f"glyphs to fall (default: {DEFAULT_RAIN_CHARS})")
    p.add_argument("--fps", type=fps_type, default=30, metavar="N",
                   help=f"target frame rate (default: 30, max: {MAX_FPS}). "
                        f"Pass '--fps max' to request the cap. Values above "
                        f"{MAX_FPS} are rejected because most YouTube content "
                        f"tops out at 60fps and terminals can't reliably draw "
                        f"faster anyway.")
    p.add_argument("--width", type=int,
                   help="output width in characters")
    p.add_argument("--height", type=int,
                   help="output height in characters")
    p.add_argument("--max-res", type=int, default=480, metavar="N",
                   help="max source video resolution (default: 480)")
    p.add_argument("--palette", choices=PALETTES, default="dense",
                   help="ASCII palette (default: dense, ~70 chars)")
    p.add_argument("--chars", help="custom palette, dark→light")
    p.add_argument("--style", choices=STYLE_NAMES, default="classic",
                   help="visual style (default: classic)")
    p.add_argument("--effect", choices=EFFECT_NAMES, default="none",
                   help="structural effect (default: none)")
    p.add_argument("--effect-glyphs", choices=("ascii", "unicode"),
                   default="ascii", metavar="MODE",
                   help="glyph set for structural effects: ascii or unicode "
                        "(default: ascii)")
    p.add_argument("--effect-speed", type=effect_speed_type, default=1.0,
                   metavar="N",
                   help="animation-speed multiplier for structural effects "
                        "(default: 1.0)")
    p.add_argument("--effect-seed", type=int, default=0, metavar="N",
                   help="deterministic procedural-layout seed (default: 0)")
    p.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    return p.parse_args()


def prompt_for_url():
    """Interactive entry point: show a banner and let the user paste a YouTube
    link. Used when launched with no URL (e.g. by double-clicking the packaged
    executable). Returns the link; exits on q / Ctrl-D / Ctrl-C."""
    cyan, gray, bold, reset = "\x1b[36m", "\x1b[90m", "\x1b[1m", "\x1b[0m"
    sys.stdout.write(
        "\x1b[2J\x1b[H"
        f"{cyan}{bold}"
        "   +-----------------------------------------------+\n"
        "   |   yt-ascii  -  YouTube as ASCII in your shell  |\n"
        "   +-----------------------------------------------+"
        f"{reset}\n\n"
        f"{gray}   Paste a YouTube link and press Enter to play it.\n"
        "   While playing:  space=pause  <-/-> +-5s  up/down +-30s  "
        "0-9=jump  s=style  e=effect  q=quit\n"
        "   Run with --help for color / audio / effect options."
        f"{reset}\n\n"
    )
    sys.stdout.flush()
    while True:
        try:
            line = input(f"   {cyan}>{reset} paste link (q to quit): ").strip()
        except (EOFError, KeyboardInterrupt):
            sys.stdout.write("\n")
            sys.exit(0)
        if line.lower() in ("q", "quit", "exit"):
            sys.exit(0)
        if line:
            return line


def run(args, automatic_update_check=None):
    half_block = args.pixels and not args.no_color
    color = not args.no_color
    # One reveal animation may be active per run (the flags are mutually
    # exclusive); reveal_secs is its fill time, pulled from the matching knob.
    if args.rain:
        reveal_style = "rain"
        reveal_secs = max(0.1, args.rain_secs)
    elif args.scatter:
        reveal_style = "scatter"
        reveal_secs = max(0.1, args.scatter_secs)
    else:
        reveal_style = None
        reveal_secs = 0.0

    import numpy as np
    from yt_ascii_effects import EffectProcessor
    from yt_ascii_frames import EffectContext
    from yt_ascii_renderer import AnsiRenderer
    from yt_ascii_styles import StyleProcessor

    style_processor = StyleProcessor(args.style)
    args.style = style_processor.name
    style_processor.reset()  # each new media item starts with fresh style state
    effect_processor = EffectProcessor(
        getattr(args, "effect", "none"),
        glyph_mode=getattr(args, "effect_glyphs", "ascii"),
        speed=getattr(args, "effect_speed", 1.0),
        seed=getattr(args, "effect_seed", 0),
    )
    args.effect = effect_processor.name
    effect_processor.reset("source")

    chars = args.chars or PALETTES[args.palette]
    if not chars:
        fail("palette must be non-empty")
    if "\x00" in chars:
        fail("palette cannot contain NUL")

    sys.stderr.write("Resolving stream…\n")
    try:
        info = probe(args.url, args.max_res)
    except ProbeError as e:
        fail(str(e))
    report_automatic_update(automatic_update_check)

    def compute_dims():
        """Read terminal size and derive output (cols, rows, ow, oh)."""
        c, r = shutil.get_terminal_size((80, 24))
        if args.width and args.height:
            return c, r, args.width, args.height
        if args.width:
            w = args.width
            h = max(1, round(w / (info["width"] / info["height"]) / CHAR_ASPECT))
            return c, r, w, h
        if args.height:
            h = args.height
            w = max(1, round(h * (info["width"] / info["height"]) * CHAR_ASPECT))
            return c, r, w, h
        w, h = fit_to_terminal(c, r, info["width"], info["height"])
        return c, r, w, h

    cols, rows, ow, oh = compute_dims()
    pix_h = oh * 2 if half_block else oh   # source-pixel height ffmpeg scales to

    pixel_fallback = half_block and args.effect in GLYPH_EFFECT_NAMES
    mode_label = (
        "pixels→chars" if pixel_fallback
        else "pixels" if half_block
        else "color-chars" if not args.no_color
        else "gray-chars"
    )
    audio_enabled = not args.no_audio and bool(find_ffplay())
    audio_label = (
        "8-bit audio" if (audio_enabled and args.eight_bit)
        else ("audio" if audio_enabled else "no audio")
    )
    sys.stderr.write(
        f"▶ {info['title']}\n"
        f"  source {info['width']}x{info['height']}  "
        f"→  terminal {ow}x{oh} chars @ {args.fps}fps  "
        f"({mode_label}, {audio_label})\n"
    )

    # Playback timeline:
    #   seek_pos = video time at the start of the current decoder segment
    #   seek_at  = wall clock when the current segment began
    # current playback position is therefore seek_pos + (now - seek_at)
    state = {"video": None, "audio": None}
    seek_pos = 0.0
    seek_at = time.monotonic()
    frame_no = 0          # frames consumed within current segment
    presented_sequence = 0
    paused = False
    pause_started = 0.0
    # Reveal animation: wall-clock time the current segment's reveal began
    # (set on the first rendered frame; None until then, and when disabled).
    reveal_start = None
    # The raw frame is retained as a zero-copy view of ``frame_buffer``. While
    # paused that buffer is stable, allowing an immediate style redraw without
    # restarting or advancing the decoder.
    last_frame = None
    last_frame_time = 0.0
    last_reveal_fraction = 1.0

    def current_pos():
        if paused:
            return seek_pos + (pause_started - seek_at)
        return seek_pos + (time.monotonic() - seek_at)

    def start_at(pos):
        state["video"] = spawn_video(info, args.fps, ow, pix_h, pos)
        if audio_enabled:
            state["audio"] = spawn_audio(info, pos, args.eight_bit)

    def stop_all():
        stop_procs(state["video"], state["audio"])
        state["video"] = state["audio"] = None

    def seek_to(new_pos):
        nonlocal seek_pos, seek_at, frame_no, presented_sequence, paused, last_frame
        if info["duration"]:
            new_pos = max(0.0, min(new_pos, info["duration"] - 0.5))
        else:
            new_pos = max(0.0, new_pos)
        stop_all()
        start_at(new_pos)
        seek_pos = new_pos
        seek_at = time.monotonic()
        frame_no = 0
        presented_sequence = 0
        paused = False  # resume on seek so the user sees the new position
        last_frame = None
        style_processor.reset()
        effect_processor.reset("seek")
        begin_reveal()  # replay the reveal from the new position

    def toggle_pause():
        nonlocal paused, pause_started, seek_at, reveal_start, seek_pos, frame_no
        if not paused:
            pause_started = time.monotonic()
            if _CAN_SUSPEND:
                signal_proc(state["video"], signal.SIGSTOP)
                signal_proc(state["audio"], signal.SIGSTOP)
            else:
                # No process-suspend (Windows): freeze the clock right here and
                # stop the decoders; we respawn from this spot on resume.
                seek_pos = current_pos()
                seek_at = pause_started     # current_pos() == seek_pos paused
                stop_all()
            paused = True
        else:
            delta = time.monotonic() - pause_started
            if reveal_start is not None:
                reveal_start += delta       # keep the reveal frozen while paused
            if _CAN_SUSPEND:
                seek_at += delta
                signal_proc(state["video"], signal.SIGCONT)
                signal_proc(state["audio"], signal.SIGCONT)
            else:
                start_at(seek_pos)
                seek_at = time.monotonic()
                frame_no = 0
            paused = False

    def do_resize():
        """Recompute output size and restart the video decoder in place.
        Audio is left running so there's no audible gap on resize."""
        nonlocal cols, rows, ow, oh, pix_h, frame_size
        nonlocal frame_buffer, discard_buffer, reveal_start
        nonlocal seek_pos, seek_at, frame_no, presented_sequence
        nonlocal pause_started, last_frame
        new_cols, new_rows, new_ow, new_oh = compute_dims()
        if (new_ow, new_oh, new_cols) == (ow, oh, cols):
            return
        resize_at = time.monotonic()
        pos = current_pos()
        if paused and reveal_start is not None:
            # Account for the paused interval before resetting pause_started;
            # resume will add the remainder after this resize.
            reveal_start += resize_at - pause_started
        cols, rows = new_cols, new_rows
        ow, oh = new_ow, new_oh
        pix_h = oh * 2 if half_block else oh
        frame_size = ow * pix_h * channels
        frame_buffer = bytearray(frame_size)
        discard_buffer = bytearray(frame_size)
        stop_proc(state["video"])
        state["video"] = None
        # Windows pause stops the decoders instead of suspending them. Do not
        # spawn a decoder during a paused resize; resume will start exactly one.
        if not paused or _CAN_SUSPEND:
            state["video"] = spawn_video(info, args.fps, ow, pix_h, pos)
        seek_pos = pos
        seek_at = resize_at
        frame_no = 0
        presented_sequence = 0
        last_frame = None
        style_processor.reset()
        effect_processor.reset("resize")
        if paused:
            pause_started = resize_at
            if _CAN_SUSPEND:
                signal_proc(state["video"], signal.SIGSTOP)
        sys.stdout.write("\x1b[2J\x1b[H")  # clear; old frame had wrong dims
        sys.stdout.flush()
        # A reveal in progress just continues at the new size: its progress is
        # wall-clock based, so the scatter mask reshuffles to the new dims and
        # the rain reshuffles its columns to the new width on the next frame.

    retry = {"n": 0, "pos": -1.0}
    def recover_stream():
        """The video pipe closed before the end of the video. A close near the
        known end is a normal finish; otherwise the stream dropped (the
        googlevideo URL expired, or a network blip outlasted ffmpeg's own
        reconnect) — refresh the URL and resume from the last shown frame.
        Returns True if playback resumed, False if we should stop."""
        nonlocal seek_pos, seek_at, frame_no, paused, last_frame
        pos = seek_pos + frame_no * frame_dur
        dur = info["duration"]
        if dur and pos >= dur - 1.0:
            return False  # reached the end — a normal finish

        # Count consecutive failures at (roughly) the same spot so a truly
        # dead stream gives up instead of looping forever.
        if abs(pos - retry["pos"]) < 1.0:
            retry["n"] += 1
        else:
            retry["n"], retry["pos"] = 1, pos
        if retry["n"] > MAX_STREAM_RETRIES:
            return False

        sys.stdout.write(f"\x1b[{oh + 1};1H\x1b[0m  ⟳ reconnecting…\x1b[K")
        sys.stdout.flush()
        try:
            info.update(probe(args.url, args.max_res))
        except Exception:
            pass  # keep the old URL; recovery must never crash the player
        stop_all()
        start_at(pos)
        seek_pos, seek_at, frame_no, paused = pos, time.monotonic(), 0, False
        last_frame = None
        style_processor.reset()
        return True

    resize_flag = [False]
    def on_winch(*_):
        resize_flag[0] = True
    if hasattr(signal, "SIGWINCH"):
        signal.signal(signal.SIGWINCH, on_winch)

    # Put stdin in cbreak mode so we can read single keys without Enter.
    fd = sys.stdin.fileno()
    is_tty = os.isatty(fd)
    old_term = None
    if is_tty and not IS_WINDOWS:
        try:
            old_term = termios.tcgetattr(fd)
            tty.setcbreak(fd)
        except Exception:
            is_tty = False

    sys.stdout.write("\x1b[?25l\x1b[2J\x1b[H")  # hide cursor, clear, home
    sys.stdout.flush()

    frame_dur = 1.0 / args.fps
    channels = 3
    frame_size = ow * pix_h * channels
    frame_buffer = bytearray(frame_size)
    discard_buffer = bytearray(frame_size)

    rain_chars = RAIN_CHARSETS.get(args.rain_chars, args.rain_chars)
    if not rain_chars:
        fail("--rain-chars must be a preset "
             f"({', '.join(RAIN_CHARSETS)}) or a non-empty string of glyphs")
    if "\x00" in rain_chars:
        fail("--rain-chars cannot contain NUL")
    renderer = AnsiRenderer(
        chars,
        color=color,
        half_block=half_block,
        rain_chars=rain_chars,
    )

    def render_frame(
        frame, video_time, reveal_fraction, *, advance_state, sequence
    ):
        """Compose style, structural effect, reveal, then terminal bytes."""
        styled = style_processor.apply(frame, video_time)
        context = EffectContext(
            video_time=video_time,
            frame_sequence=sequence,
            cell_shape=(oh, ow),
            requested_pixels=half_block,
            advance_state=advance_state,
        )
        effected = effect_processor.apply(styled, context)
        if reveal_fraction < 1.0:
            reveal_method = (
                renderer.render_rain
                if reveal_style == "rain"
                else renderer.render_scatter
            )
            if effected.cells is None:
                return reveal_method(effected.rgb, reveal_fraction)
            return reveal_method(
                effected.rgb, reveal_fraction, effected.cells
            )
        if effected.cells is None:
            return renderer.render(effected.rgb)
        return renderer.render(effected.rgb, effected.cells)

    def redraw_paused_frame():
        """Render the retained raw frame with the current paused state."""
        if last_frame is None:
            return
        body = render_frame(
            last_frame,
            last_frame_time,
            last_reveal_fraction,
            advance_state=False,
            sequence=presented_sequence,
        )
        status = build_status(
            args.fps, current_pos(), info, cols, paused=True,
            style=args.style, effect=args.effect,
            pixel_fallback=half_block and args.effect in GLYPH_EFFECT_NAMES,
        )
        write_terminal_frame(body, status)

    def cycle_style():
        """Select the next style; the caller coordinates any paused redraw."""
        args.style = style_processor.cycle()
        effect_processor.reset("style")

    def cycle_effect():
        """Select the next structural effect without restarting playback."""
        args.effect = effect_processor.cycle()

    def begin_reveal():
        """Start (or restart, after a seek) the current reveal animation: clear
        the screen so the picture builds on from nothing. The effect then grows
        in the render path, against the live frames. No-op when disabled."""
        nonlocal reveal_start
        reveal_start = None
        if reveal_style:
            renderer.reset_reveal()
            sys.stdout.write("\x1b[2J\x1b[H")
            sys.stdout.flush()

    start_at(0.0)
    seek_at = time.monotonic()  # pace from first-frame time, not probe time
    begin_reveal()

    try:
        while True:
            # ── Handle keyboard ──────────────────────────────────────────
            quit_now = False
            style_changed = False
            effect_changed = False
            pending_seek = None  # final target after applying all queued keys
            if is_tty:
                for key in read_keys(fd):
                    if key == "q":
                        quit_now = True
                        break
                    if key == "space":
                        toggle_pause()
                        continue
                    if key == "s":
                        cycle_style()
                        style_changed = True
                        continue
                    if key == "e":
                        cycle_effect()
                        effect_changed = True
                        continue
                    base = pending_seek if pending_seek is not None else current_pos()
                    if key == "left":
                        pending_seek = base - 5
                    elif key == "right":
                        pending_seek = base + 5
                    elif key == "down":
                        pending_seek = base - 30
                    elif key == "up":
                        pending_seek = base + 30
                    elif key.isdigit() and info["duration"]:
                        pending_seek = info["duration"] * int(key) / 10
            if quit_now:
                break
            if pending_seek is not None:
                seek_to(pending_seek)
            # Key reads are batches. Redraw after the whole batch so both
            # ``space, s`` and ``s, space`` end with a correctly styled frozen
            # frame rather than a new label over the previous style.
            if (style_changed or effect_changed) and paused:
                redraw_paused_frame()

            if resize_flag[0]:
                resize_flag[0] = False
                do_resize()

            # ── Paused: just idle and keep the status line updating ─────
            if paused:
                pos = current_pos()
                status = build_status(
                    args.fps, pos, info, cols, paused=True,
                    style=args.style, effect=args.effect,
                    pixel_fallback=(
                        half_block and args.effect in GLYPH_EFFECT_NAMES
                    ),
                )
                sys.stdout.write(f"\x1b[{oh + 1};1H" + status + "\x1b[K")
                sys.stdout.flush()
                time.sleep(0.05)
                continue

            # ── Drop frames if behind, to stay in sync with audio ───────
            now = time.monotonic()
            seg_elapsed = now - seek_at
            target = int(seg_elapsed * args.fps)
            if frame_no < target - 1:
                skip = target - frame_no - 1
                dropped = discard_frames(
                    state["video"].stdout, skip, discard_buffer
                )
                frame_no += dropped
                if dropped != skip:
                    if recover_stream():
                        continue
                    break

            received = read_exact_into(state["video"].stdout, frame_buffer)
            if received != frame_size:
                if recover_stream():
                    continue
                break

            frame = np.frombuffer(frame_buffer, dtype=np.uint8)
            frame = frame.reshape(pix_h, ow, 3)
            frame_time = seek_pos + frame_no * frame_dur

            # Reveal animations unmask the live frame over `reveal_secs`, timed
            # from the first frame actually shown (so a slow stream connect
            # doesn't eat the start of the effect).
            if reveal_style:
                rnow = time.monotonic()
                if reveal_start is None:
                    reveal_start = rnow
                frac = (rnow - reveal_start) / reveal_secs
            else:
                frac = 1.0
            body = render_frame(
                frame,
                frame_time,
                frac,
                advance_state=True,
                sequence=presented_sequence,
            )
            last_frame = frame
            last_frame_time = frame_time
            last_reveal_fraction = frac
            presented_sequence += 1

            pos = seek_pos + seg_elapsed
            status = build_status(
                args.fps, pos, info, cols, paused=False,
                style=args.style, effect=args.effect,
                pixel_fallback=(
                    half_block and args.effect in GLYPH_EFFECT_NAMES
                ),
            )

            write_terminal_frame(body, status)

            frame_no += 1
            delay = (seek_at + frame_no * frame_dur) - time.monotonic()
            if delay > 0:
                time.sleep(delay)
    except KeyboardInterrupt:
        pass
    finally:
        stop_all()
        if old_term is not None and termios is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_term)
        sys.stdout.write("\x1b[0m\x1b[?25h\n")
        sys.stdout.flush()


def _terminal_cell_width(text):
    """Return a conservative terminal width using only the standard library."""
    width = 0
    for char in text:
        if unicodedata.combining(char) or unicodedata.category(char) in ("Cf", "Cc"):
            continue
        width += 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1
    return width


def _truncate_terminal_cells(text, limit):
    """Truncate text without splitting a character past the terminal edge."""
    result = []
    used = 0
    for char in text:
        if unicodedata.category(char) in ("Cf", "Cc"):
            continue
        char_width = _terminal_cell_width(char)
        if used + char_width > limit:
            break
        result.append(char)
        used += char_width
    return "".join(result)


def build_status(
    fps, pos, info, cols, paused, style="classic", effect="none",
    pixel_fallback=False,
):
    if info["duration"]:
        clock = f"{fmt_time(pos)} / {fmt_time(info['duration'])}"
    else:
        clock = fmt_time(pos)
    tag = "‖ PAUSED" if paused else "▶"
    width = max(0, int(cols))
    effect_label = f"effect:{effect}"
    if pixel_fallback:
        effect_label += " pixels→chars"
    head_options = (
        f"  {tag}  {clock}  {fps}fps  style:{style}  {effect_label}",
        f"  {tag}  {clock}  style:{style}  {effect_label}",
        f"  {clock}  style:{style}  {effect_label}",
        f"  style:{style}  {effect_label}",
        f"  {effect_label}",
    )
    control_options = (
        "space:pause  s:style  e:effect  ←→±5s  ↑↓±30s  0-9:jump  q:quit",
        "space:pause  s:style  e:effect  arrows:seek  0-9:jump  q:quit",
        "space  s:style  e:effect  arrows:seek  q:quit",
        "s:style  e:effect  q:quit",
    )
    head = controls = fallback_head = ""
    title_reserve = min(12, _terminal_cell_width(info.get("title", "")))
    for reserve in ((title_reserve, 0) if title_reserve else (0,)):
        for candidate_head in head_options:
            candidate_width = _terminal_cell_width(candidate_head)
            if candidate_width > width:
                continue
            if not fallback_head:
                fallback_head = candidate_head
            candidate_controls = next(
                (
                    value for value in control_options
                    if candidate_width + 2 + _terminal_cell_width(value) + reserve
                    <= width
                ),
                "",
            )
            if candidate_controls:
                head, controls = candidate_head, candidate_controls
                break
        if controls:
            break
    if not head:
        head = fallback_head
    if not head:
        return "\x1b[0m" + _truncate_terminal_cells(head_options[-1], width)
    head_width = _terminal_cell_width(head)
    controls_width = _terminal_cell_width(controls) + 2 if controls else 0
    title_room = max(0, width - head_width - controls_width - 2)
    title = (
        _truncate_terminal_cells(info["title"], title_room)
        if title_room else ""
    )
    visible = head
    if title:
        visible += "  " + title
    if controls:
        visible += "  " + controls
    return "\x1b[0m" + _truncate_terminal_cells(visible, width)


def self_test():
    """Exercise bundled NumPy, every style/effect and rendering offline."""
    import numpy as np
    from yt_ascii_effects import (
        EFFECT_NAMES as IMPLEMENTED_EFFECTS,
        EFFECT_SPECS,
        EffectProcessor,
    )
    from yt_ascii_frames import EffectContext
    from yt_ascii_renderer import AnsiRenderer
    from yt_ascii_styles import STYLE_NAMES as IMPLEMENTED_STYLES, StyleProcessor

    if tuple(IMPLEMENTED_STYLES) != STYLE_NAMES:
        fail("style registry self-test failed")
    if tuple(IMPLEMENTED_EFFECTS) != EFFECT_NAMES:
        fail("effect registry self-test failed")
    implemented_glyph_effects = frozenset(
        spec.name for spec in EFFECT_SPECS if spec.glyph_owned
    )
    if implemented_glyph_effects != GLYPH_EFFECT_NAMES:
        fail("effect pixel-policy self-test failed")

    frame = np.array([[[1, 2, 3]]], dtype=np.uint8)
    expected = b"\x1b[38;2;1;2;3mx\x1b[0m\x1b[K"
    if AnsiRenderer("x").render(frame) != expected:
        fail("renderer self-test failed")

    sample = np.arange(8 * 8 * 3, dtype=np.uint8).reshape(8, 8, 3)
    processor = StyleProcessor()
    renderer = AnsiRenderer(" .#")
    for name in STYLE_NAMES:
        processor.select(name)
        styled = processor.apply(sample, 0.25)
        if styled.shape != sample.shape or styled.dtype != np.uint8:
            fail(f"{name} style self-test failed")
        if not renderer.render(styled):
            fail(f"{name} style renderer self-test failed")

    effect_processor = EffectProcessor()
    context = EffectContext(
        video_time=0.25,
        frame_sequence=0,
        cell_shape=sample.shape[:2],
        requested_pixels=False,
        advance_state=True,
    )
    for name in EFFECT_NAMES:
        effect_processor.select(name)
        effected = effect_processor.apply(sample, context)
        if effected.rgb.dtype != np.uint8 or effected.rgb.ndim != 3:
            fail(f"{name} effect self-test failed")
        output = renderer.render(effected.rgb, effected.cells)
        if not output:
            fail(f"{name} effect renderer self-test failed")
        if name in GLYPH_EFFECT_NAMES:
            unicode_effected = EffectProcessor(
                name, glyph_mode="unicode"
            ).apply(sample, context)
            if unicode_effected.cells is None or not renderer.render(
                unicode_effected.rgb, unicode_effected.cells
            ):
                fail(f"{name} Unicode effect self-test failed")
        if name == "afterimage":
            moved = np.roll(sample, 1, axis=1)
            later = EffectContext(
                video_time=0.5,
                frame_sequence=1,
                cell_shape=sample.shape[:2],
                requested_pixels=False,
                advance_state=True,
            )
            temporal = effect_processor.apply(moved, later)
            if not renderer.render(temporal.rgb, temporal.cells):
                fail("afterimage temporal self-test failed")

    pixel_sample = np.repeat(sample, 2, axis=0)
    pixel_context = EffectContext(
        video_time=0.25,
        frame_sequence=0,
        cell_shape=sample.shape[:2],
        requested_pixels=True,
        advance_state=True,
    )
    pixel_renderer = AnsiRenderer(" .#", half_block=True)
    for name in EFFECT_NAMES:
        if name not in GLYPH_EFFECT_NAMES:
            continue
        effect_processor.select(name)
        effected = effect_processor.apply(pixel_sample, pixel_context)
        if (
            effected.cells is None
            or effected.cells.glyph_indices.shape != pixel_context.cell_shape
            or effected.cells.fg_rgb is None
            or effected.cells.fg_rgb.shape != pixel_context.cell_shape + (3,)
        ):
            fail(f"{name} pixel fallback contract self-test failed")
        if not pixel_renderer.render(effected.rgb, effected.cells):
            fail(f"{name} pixel fallback self-test failed")
    sys.stdout.write("yt-ascii self-test: ok\n")


def run_update_action(args):
    """Run an explicit managed-install check/update before app dependencies."""
    if args.url is not None:
        fail("--update and --check-update cannot be combined with a video URL")
    try:
        import yt_ascii_update
    except Exception as error:
        sys.stderr.write(
            f"yt-ascii: updater module is unavailable or invalid: {error}\n"
        )
        sys.stderr.flush()
        return 1

    update_error = getattr(yt_ascii_update, "UpdateError", None)
    try:
        installation = yt_ascii_update.discover_install()
        if args.check_update:
            status = yt_ascii_update.check_for_update(
                installation, timeout=10.0
            )
            stream = sys.stdout if status.ok and status.supported else sys.stderr
            stream.write(f"yt-ascii: {status.display}\n")
            stream.flush()
            return 0 if status.ok and status.supported else 1
        return yt_ascii_update.delegate_update(installation)
    except Exception as error:
        expected = (
            isinstance(update_error, type)
            and issubclass(update_error, Exception)
            and isinstance(error, update_error)
        )
        message = str(error) if expected else f"updater failed: {error}"
        sys.stderr.write(f"yt-ascii: {message}\n")
        sys.stderr.flush()
        return 1


def start_automatic_update(args):
    """Start one silent best-effort channel check for a normal player launch."""
    if (
        getattr(args, "no_update_check", False)
        or os.environ.get("YTASCII_NO_UPDATE_CHECK") == "1"
    ):
        return None
    try:
        import yt_ascii_update
        installation = yt_ascii_update.discover_install()
        return yt_ascii_update.start_auto_check(installation, timeout=2.0)
    except Exception:
        return None


def report_automatic_update(check):
    """Print an available-update notice if a background check already finished."""
    if check is None:
        return
    try:
        status = check.consume()
    except Exception:
        return
    if status is not None:
        sys.stderr.write(
            f"yt-ascii: {status.display}; run yt-ascii --update\n"
        )
        sys.stderr.flush()


def main():
    _enable_windows_ansi()
    args = parse_args()
    if getattr(args, "update", False) or getattr(args, "check_update", False):
        raise SystemExit(run_update_action(args))
    automatic_update_check = (
        None if args.self_test else start_automatic_update(args)
    )
    check_deps()
    if args.self_test:
        self_test()
        return
    interactive = args.url is None
    while True:
        if interactive:
            args.url = prompt_for_url()      # exits the program on q / Ctrl-D
        if automatic_update_check is None:
            run(args)
        else:
            run(args, automatic_update_check)
        if not interactive:
            return


if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        sys.stdout.write("\x1b[0m\x1b[?25h\n")
