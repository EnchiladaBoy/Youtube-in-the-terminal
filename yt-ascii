def _next_palette_name(current):
    """Return the next built-in palette; custom selections enter at simple."""
    if current == "custom":
        return PALETTE_NAMES[0]
    try:
        index = PALETTE_NAMES.index(current)
    except ValueError as error:
        raise ValueError(f"unknown palette {current!r}") from error
    return PALETTE_NAMES[(index + 1) % len(PALETTE_NAMES)]

