def validate_effect_text(value, glyph_mode="ascii"):
    """Return a safe, unchanged terminal-HUD label.

    This validation deliberately stays in the dependency-free launcher so
    ``--help`` and argument errors work before NumPy is installed.  The effect
    engine repeats the same checks for direct programmatic callers.
    """
    if not isinstance(value, str):
        raise TypeError("--effect-text must be text")
    if glyph_mode not in ("ascii", "unicode"):
        raise ValueError("effect glyph mode must be 'ascii' or 'unicode'")
    if not 1 <= len(value) <= 253:
        raise ValueError("--effect-text must contain 1..253 code points")
    if all(char == " " for char in value):
        raise ValueError(
            "--effect-text must contain at least one non-space character"
        )

    for position, char in enumerate(value, start=1):
        category = unicodedata.category(char)
        unsafe = (
            (char != " " and char.isspace())
            or not char.isprintable()
            or category in ("Cc", "Cf", "Cs")
            or category.startswith("M")
            or bool(unicodedata.combining(char))
            or unicodedata.bidirectional(char) in _RTL_EFFECT_TEXT_BIDI_CLASSES
            or unicodedata.east_asian_width(char) in ("W", "F")
        )
        if unsafe:
            raise ValueError(
                "--effect-text contains an unsupported code point at "
                f"position {position} (U+{ord(char):04X}); only safe "
                "single-cell left-to-right characters are allowed"
            )
        if glyph_mode == "ascii" and not 0x20 <= ord(char) <= 0x7E:
            raise ValueError(
                "--effect-text contains a non-ASCII code point at "
                f"position {position} (U+{ord(char):04X}); use "
                "--effect-glyphs unicode for safe Unicode text"
            )
    return value


def validate_rain_chars(value):
    """Validate a preset name or bounded custom single-cell reveal alphabet."""
    if not isinstance(value, str):
        raise TypeError("--rain-chars must be text")
    if value in RAIN_CHARSETS:
        return value
    if not 1 <= len(value) <= 256:
        raise ValueError(
            "--rain-chars must be a preset or contain 1..256 code points"
        )
    for position, char in enumerate(value, start=1):
        category = unicodedata.category(char)
        unsafe = (
            (char != " " and char.isspace())
            or not char.isprintable()
            or category in ("Cc", "Cf", "Cs")
            or category.startswith("M")
            or bool(unicodedata.combining(char))
            or unicodedata.bidirectional(char) in _RTL_EFFECT_TEXT_BIDI_CLASSES
            or unicodedata.east_asian_width(char) in ("W", "F")
        )
        if unsafe:
            raise ValueError(
                "--rain-chars contains an unsupported code point at "
                f"position {position} (U+{ord(char):04X}); only printable "
                "single-cell left-to-right glyphs are allowed"
            )
    return value


def fail(msg, code=1):
    sys.stderr.write(f"yt-ascii: {msg}\n")
    sys.exit(code)


def _bundle_dir():
    """Directory PyInstaller unpacks bundled files into (and where we look for a
    bundled ffmpeg/ffplay), or None when running from source."""
    return getattr(sys, "_MEIPASS", None)


def _bundled_tool(name):
    """Path to a binary shipped inside the frozen app (via --add-binary), or
    None. `name` is the base name; the .exe variant is tried too (Windows)."""
    d = _bundle_dir()
    if not d:
        return None
    for cand in (os.path.join(d, name + ".exe"), os.path.join(d, name)):
        if os.path.isfile(cand):
            return cand
    return None


@functools.lru_cache(maxsize=None)
def find_ffmpeg():
    """Locate an ffmpeg binary. A system ffmpeg is preferred: it is dynamically
    linked and resolves DNS reliably, whereas the statically linked build we can
    bundle can fail name resolution on some hosts. It is still the fallback for
    machines that have no ffmpeg at all. Order:
        $YTASCII_FFMPEG -> system PATH -> bundled -> imageio-ffmpeg's build."""
    env = os.environ.get("YTASCII_FFMPEG")
    if env and os.path.isfile(env):
        return env
    sys_exe = shutil.which("ffmpeg")
    if sys_exe:
        return sys_exe
    bundled = _bundled_tool("ffmpeg")
    if bundled:
        return bundled
    try:
        import imageio_ffmpeg
        exe = imageio_ffmpeg.get_ffmpeg_exe()
        if exe and os.path.isfile(exe):
            if not os.access(exe, os.X_OK):
                try:
                    os.chmod(exe, 0o755)
                except OSError:
                    pass
            return exe
    except Exception:
        pass
    return None


@functools.lru_cache(maxsize=None)
def find_ffplay():
    """Locate ffplay for audio: $YTASCII_FFPLAY -> system PATH -> bundled.
    imageio-ffmpeg doesn't ship ffplay, so None ⇒ play silently."""
    env = os.environ.get("YTASCII_FFPLAY")
    if env and os.path.isfile(env):
        return env
    sys_exe = shutil.which("ffplay")
    if sys_exe:
        return sys_exe
    return _bundled_tool("ffplay")


def _popen_kwargs():
    """Keep ffmpeg/ffplay from flashing a console window on Windows."""
    if IS_WINDOWS:
        return {"creationflags": getattr(subprocess, "CREATE_NO_WINDOW", 0)}
    return {}


def _enable_windows_ansi():
    """Enable ANSI escape processing and UTF-8 output in the Windows console so
    color and the block/katakana glyphs render. No-op on other platforms."""
    if not IS_WINDOWS:
        return
    try:
        import ctypes
        kernel32 = ctypes.windll.kernel32
        handle = kernel32.GetStdHandle(-11)            # STD_OUTPUT_HANDLE
        mode = ctypes.c_uint32()
        if kernel32.GetConsoleMode(handle, ctypes.byref(mode)):
            kernel32.SetConsoleMode(handle, mode.value | 0x0004)  # VT processing
    except Exception:
        pass
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8")
        except Exception:
            pass


def have_ytdlp():
    """True if yt-dlp is usable, as a library (preferred, bundled) or a CLI."""
    try:
        import yt_dlp  # noqa: F401
        return True
    except ImportError:
        return bool(shutil.which("yt-dlp"))


def check_deps():
    missing = []
    if find_ffmpeg() is None:
        missing.append(("ffmpeg", "install ffmpeg, or: pip install imageio-ffmpeg"))
    if not have_ytdlp():
        missing.append(("yt-dlp", "pip install yt-dlp (or your package manager)"))
    try:
        import numpy  # noqa: F401
    except ImportError:
        missing.append(("numpy", "pip install numpy"))
    if missing:
        lines = "\n".join(f"  - {n}: {c}" for n, c in missing)
        fail(f"missing dependencies:\n{lines}")


def _probe_info(url, fmt):
    """Fetch yt-dlp's info dict for `url`, via the Python API when it's
    importable (the packaged build bundles it), else the yt-dlp CLI."""
    try:
        import yt_dlp
    except ImportError:
        yt_dlp = None
    if yt_dlp is not None:
        opts = {"format": fmt, "quiet": True, "no_warnings": True,
                "noplaylist": True, "skip_download": True,
                "extractor_args": {"youtube": {"player_client": YOUTUBE_CLIENTS}}}
        try:
            with yt_dlp.YoutubeDL(opts) as ydl:
                info = ydl.extract_info(url, download=False)
        except Exception as e:
            raise ProbeError(f"yt-dlp failed: {e}")
        if info is None:
            raise ProbeError("yt-dlp returned no metadata")
        return info
    exe = shutil.which("yt-dlp")
    if not exe:
        raise ProbeError("yt-dlp not found")
    meta = subprocess.run(
        [exe, "-f", fmt, "-j", "--no-warnings", "--no-playlist",
         "--extractor-args", "youtube:player_client=" + ",".join(YOUTUBE_CLIENTS),
         url],
        capture_output=True, text=True,
    )
    if meta.returncode != 0:
        raise ProbeError(f"yt-dlp failed:\n{meta.stderr.strip()}")
    try:
        return json.loads(meta.stdout.splitlines()[0])
    except (json.JSONDecodeError, IndexError):
        raise ProbeError("yt-dlp returned no metadata")


def probe(url, max_h):
    fmt = (f"bestvideo[height<={max_h}][vcodec!=none]+bestaudio[acodec!=none]/"
           f"best[height<={max_h}]")
    info = _probe_info(url, fmt)

    # When yt-dlp picks "bestvideo+bestaudio" it lists both in requested_formats;
    # for a single combined format the URL sits at the top level.
    formats = info.get("requested_formats") or []
    if formats:
        video_url = formats[0].get("url")
        audio_url = (formats[1].get("url") if len(formats) > 1 else None) or video_url
        if formats[0].get("vcodec") == "none" and len(formats) > 1:
            video_url, audio_url = audio_url, video_url
    else:
        video_url = info.get("url")
        audio_url = video_url
    if not video_url:
        raise ProbeError("yt-dlp did not return a stream URL")

    return {
        "title":    info.get("title", "?"),
        "width":    int(info.get("width") or 16),
        "height":   int(info.get("height") or 9),
        "duration": float(info.get("duration") or 0),
        "is_live":  bool(info.get("is_live")),
        "fps":      info.get("fps"),
        "video":    video_url,
        "audio":    audio_url,
    }


def fit_to_terminal(cols, rows, vw, vh):
    rows = max(rows - 1, 1)
    aspect = vw / vh
    w = cols
    h = max(1, round(w / aspect / CHAR_ASPECT))
    if h > rows:
        h = rows
        w = max(1, round(h * aspect * CHAR_ASPECT))
    return w, h


def fmt_time(seconds):
    s = max(0, int(seconds))
    m, s = divmod(s, 60)
    h, m = divmod(m, 60)
    return f"{h:d}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"


# ── Keyboard input ────────────────────────────────────────────────────────────
ARROWS = {"A": "up", "B": "down", "C": "right", "D": "left"}


def read_keys(fd):
    """Drain pending keypresses into a list of key names (cross-platform)."""
    if IS_WINDOWS:
        return _read_keys_windows()
    return _read_keys_posix(fd)


def _read_keys_windows():
    keys = []
    if msvcrt is None:
        return keys
    arrows = {"H": "up", "P": "down", "K": "left", "M": "right"}
    while msvcrt.kbhit():
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):          # arrow / function-key prefix
            code = msvcrt.getwch()
            if code in arrows:
                keys.append(arrows[code])
            continue
        if ch == " ":
            keys.append("space")
        elif ch in "qQ\x03":
            keys.append("q")
        elif ch == "\x1b":
            keys.append("esc")
        elif ch == "s":
            keys.append("s")
        elif ch == "e":
            keys.append("e")
        elif ch == "p":
            keys.append("p")
        elif ch.isdigit():
            keys.append(ch)
    return keys


def _read_keys_posix(fd):
    """Drain any pending key bytes from stdin into a list of key names."""
    keys = []
    while True:
        r, _, _ = select.select([fd], [], [], 0)
        if not r:
            return keys
        try:
            data = os.read(fd, 64).decode("utf-8", errors="replace")
        except OSError:
            return keys
        if not data:
            return keys
        i = 0
        while i < len(data):
            ch = data[i]
            # ESC '[' <letter>  → arrow keys
            if ch == "\x1b" and i + 2 < len(data) and data[i + 1] == "[":
                arrow = ARROWS.get(data[i + 2])
                if arrow:
                    keys.append(arrow)
                    i += 3
                    continue
                i += 1
                continue
            if ch == "\x1b":
                keys.append("esc"); i += 1; continue
            if ch == " ":
                keys.append("space"); i += 1; continue
            if ch in "qQ\x03":  # Ctrl-C as well
                keys.append("q"); i += 1; continue
            if ch == "s":
                keys.append("s"); i += 1; continue
            if ch == "e":
                keys.append("e"); i += 1; continue
            if ch == "p":
                keys.append("p"); i += 1; continue
            if ch.isdigit():
                keys.append(ch); i += 1; continue
            i += 1


# ── Process management for video + audio ──────────────────────────────────────
def spawn_video(info, fps, ow, oh, pos, diagnostics=None):
    cmd = [find_ffmpeg()]
    capture = None
    if diagnostics is None:
        cmd += ["-loglevel", "quiet"]
    else:
        # Benchmark output is informational, so quiet mode would suppress it.
        # Capture all diagnostic stderr in an unlinked temporary file; only
        # parsed numeric ``bench:`` totals survive in the final report.
        cmd += ["-loglevel", "info", "-nostats", "-benchmark"]
        capture = diagnostics.new_ffmpeg_capture()
    cmd += RECONNECT_FLAGS
    if pos > 0:
        cmd += ["-ss", f"{pos:.3f}"]
    cmd += [
        "-i", info["video"], "-an",
        "-f", "rawvideo", "-pix_fmt", "rgb24",
        "-vf", f"fps={fps},scale={ow}:{oh}:flags=fast_bilinear",
        "-",
    ]
    kwargs = _popen_kwargs()
    if capture is not None:
        kwargs["stderr"] = capture.stream
    try:
        process = subprocess.Popen(cmd, stdout=subprocess.PIPE, **kwargs)
    except BaseException:
        if capture is not None:
            diagnostics.consume_ffmpeg_capture(capture)
        raise
    if capture is not None:
        process._ytascii_diagnostics_capture = capture
    return process


def consume_video_diagnostics(process, diagnostics):
    """Parse and discard one diagnostic decoder's temporary stderr stream."""
    if process is None or diagnostics is None:
        return
    capture = getattr(process, "_ytascii_diagnostics_capture", None)
    if capture is None:
        return
    process._ytascii_diagnostics_capture = None
    diagnostics.consume_ffmpeg_capture(capture)


def spawn_audio(info, pos, eight_bit=False):
    cmd = [find_ffplay(), "-nodisp", "-autoexit", "-loglevel", "quiet"]
    cmd += RECONNECT_FLAGS
    if pos > 0:
        cmd += ["-ss", f"{pos:.3f}"]
    if eight_bit:
        # Retro chiptune chain:
        #   aresample=22050      - chop the upper octave (no airy hi-hats)
        #   pan=mono|...         - sum L+R; classic 8-bit hardware was mono
        #   acrusher bits=4      - quantize to 4 bits (16 levels — matches
        #                          NES DPCM / Game Boy waveform RAM, much
        #                          coarser than the prior 8-bit pass)
        #   samples=4            - sample-and-hold every 4 samples, giving
        #                          the stepped, aliased "old DAC" sound
        cmd += [
            "-af",
            "aresample=22050,pan=mono|c0=0.5*c0+0.5*c1,"
            "acrusher=bits=4:mix=1:mode=log:samples=4",
        ]
    cmd.append(info["audio"])
    return subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        **_popen_kwargs(),
    )


def stop_procs(*processes):
    """Resume, terminate and reap children against one shared deadline.

    A SIGTERM remains pending while a POSIX child is SIGSTOP'd, so seeking or
    quitting from pause used to wait one second per decoder before killing it.
    Resuming every live child first and terminating the group before waiting
    makes teardown both quick and bounded.
    """
    live = []
    for process in processes:
        if process is None:
            continue
        try:
            if process.poll() is None:
                live.append(process)
        except (AttributeError, OSError):
            live.append(process)
    if not live:
        return

    if _CAN_SUSPEND:
        for process in live:
            signal_proc(process, signal.SIGCONT)
    for process in live:
        try:
            process.terminate()
        except OSError:
            pass

    deadline = time.monotonic() + 1.0
    survivors = []
    for process in live:
        try:
            process.wait(timeout=max(0.0, deadline - time.monotonic()))
        except (OSError, subprocess.TimeoutExpired):
            survivors.append(process)
    for process in survivors:
        try:
            process.kill()
        except OSError:
            pass
    # Always reap killed children; keep this cleanup bounded as well.
    reap_deadline = time.monotonic() + 0.25
    for process in survivors:
        try:
            process.wait(timeout=max(0.0, reap_deadline - time.monotonic()))
        except (OSError, subprocess.TimeoutExpired):
            pass


def stop_proc(process):
    stop_procs(process)


def signal_proc(p, sig):
    if p is None:
        return
    try:
        os.kill(p.pid, sig)
    except OSError:
        pass


def read_exact_into(stream, buffer):
    """Fill ``buffer`` from a binary stream, tolerating short reads.

    Returns the number of bytes copied. A result smaller than ``len(buffer)``
    means EOF. The caller owns the reusable bytearray, so successful reads do
    not allocate a new frame-sized ``bytes`` object.
    """
    view = memoryview(buffer)
    offset = 0
    while offset < len(view):
        count = stream.readinto(view[offset:])
        if not count:
            break
        offset += count
    return offset


def discard_frames(stream, count, scratch):
    """Drain at most ``count`` complete frames using one bounded buffer."""
    complete = 0
    for _ in range(count):
        if read_exact_into(stream, scratch) != len(scratch):
            break
        complete += 1
    return complete


def write_terminal_frame(body, status, diagnostics=None):
    """Write one already-composed UTF-8 frame, with a text-stream fallback."""
    if diagnostics is not None and (not body or b"\x00" in body):
        diagnostics.increment("output_corruption")
    payload = b"".join(
        (b"\x1b[H", body, b"\n", status.encode("utf-8"), b"\x1b[K")
    )
    binary = getattr(sys.stdout, "buffer", None)
    if binary is None:
        if diagnostics is None:
            sys.stdout.write(payload.decode("utf-8"))
            sys.stdout.flush()
            return
        else:
            with diagnostics.timer("terminal_write"):
                sys.stdout.write(payload.decode("utf-8"))
                sys.stdout.flush()
        return len(payload)
    if diagnostics is None:
        binary.write(payload)
        binary.flush()
        return
    else:
        with diagnostics.timer("terminal_write"):
            binary.write(payload)
            binary.flush()
    return len(payload)


